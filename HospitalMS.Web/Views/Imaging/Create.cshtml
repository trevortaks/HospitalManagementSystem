@model HospitalMS.Business.Models.CreateImagingRequestRequest
@using HospitalMS.Data.Persistence.Entities
@{
    ViewData["Title"] = "New Imaging Request";
    ViewData["ActivePage"] = "Imaging";
    var doctors        = ViewBag.Doctors as IReadOnlyList<HospitalMS.Business.Models.UserSummary> ?? [];
    var preEncounterId = ViewBag.PreselectedEncounterId as Guid?;
    var prePatientId   = ViewBag.PreselectedPatientId   as Guid?;
}

<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-action="Index" class="pf-breadcrumb-link">Imaging Requests</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">New Request</span>
        </div>
        <h1 class="page-header-title">New Imaging Request</h1>
    </div>
    <a asp-action="Index" class="pf-back-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back
    </a>
</div>

<form asp-action="Create" method="post" novalidate>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="dash-card">
                <div class="pf-section-header">
                    <div class="pf-section-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    </div>
                    <div>
                        <div class="pf-section-title">Request Details</div>
                    </div>
                </div>
                <div class="pf-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>
                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="EncounterId" class="pf-label">Encounter ID <span class="pf-required">*</span></label>
                            <input asp-for="EncounterId" class="pf-input" value="@(preEncounterId?.ToString() ?? "")" placeholder="Encounter UUID" />
                            <span asp-validation-for="EncounterId" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="PatientId" class="pf-label">Patient ID <span class="pf-required">*</span></label>
                            <input asp-for="PatientId" class="pf-input" value="@(prePatientId?.ToString() ?? "")" placeholder="Patient UUID" />
                            <span asp-validation-for="PatientId" class="pf-error"></span>
                        </div>
                    </div>
                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="RequestedByUserId" class="pf-label">Requested By <span class="pf-required">*</span></label>
                            <select asp-for="RequestedByUserId" class="pf-input">
                                <option value="">— Select doctor —</option>
                                @foreach (var d in doctors)
                                {
                                    <option value="@d.Id">@d.Username (@d.Role)</option>
                                }
                            </select>
                            <span asp-validation-for="RequestedByUserId" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="Modality" class="pf-label">Modality <span class="pf-required">*</span></label>
                            <select asp-for="Modality" class="pf-input">
                                <option value="">— Select modality —</option>
                                @foreach (var m in ImagingModality.All)
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                            <span asp-validation-for="Modality" class="pf-error"></span>
                        </div>
                    </div>
                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="BodyPart" class="pf-label">Body Part</label>
                            <input asp-for="BodyPart" class="pf-input" placeholder="e.g. Chest, Abdomen" />
                        </div>
                        <div class="pf-field">
                            <label asp-for="Priority" class="pf-label">Priority</label>
                            <select asp-for="Priority" class="pf-input">
                                @foreach (var p in LabOrderPriority.All)
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="pf-field">
                        <label asp-for="ClinicalIndication" class="pf-label">Clinical Indication</label>
                        <textarea asp-for="ClinicalIndication" class="pf-input" rows="2" placeholder="Reason for imaging…"></textarea>
                    </div>
                </div>
                <div class="pf-footer">
                    <a asp-action="Index" class="pf-btn-cancel">Cancel</a>
                    <button type="submit" class="btn-primary-dash">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        Submit Request
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
