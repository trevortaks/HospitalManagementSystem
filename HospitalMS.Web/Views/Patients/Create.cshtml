@model HospitalMS.Business.Models.CreatePatientRequest
@{
    ViewData["Title"] = "Add Patient";
    ViewData["ActivePage"] = "Patients";
}

<!-- Page header -->
<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-controller="Dashboard" asp-action="Index" class="pf-breadcrumb-link">Dashboard</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <a asp-action="Index" class="pf-breadcrumb-link">Patients</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">Add Patient</span>
        </div>
        <h1 class="page-header-title">Add Patient</h1>
    </div>
    <a asp-action="Index" class="pf-back-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Back to Patients
    </a>
</div>

<form asp-action="Create" method="post" novalidate>
    <div class="row g-4 align-items-start">

        <!-- Main form card -->
        <div class="col-lg-8">
            <div class="dash-card">

                <div class="pf-section-header">
                    <div class="pf-section-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <div>
                        <div class="pf-section-title">Patient Information</div>
                        <div class="pf-section-subtitle">Enter the patient's personal and contact details.</div>
                    </div>
                </div>

                <div class="pf-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <!-- MRN (full width) -->
                    <div class="pf-field mb-4">
                        <label asp-for="MedicalRecordNumber" class="pf-label">
                            Medical Record Number
                            <span class="pf-required">*</span>
                        </label>
                        <div class="pf-input-wrap">
                            <span class="pf-input-prefix">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                                </svg>
                            </span>
                            <input asp-for="MedicalRecordNumber" class="pf-input pf-input--prefixed"
                                   placeholder="e.g. MRN-2026-001" autocomplete="off" />
                        </div>
                        <span asp-validation-for="MedicalRecordNumber" class="pf-error"></span>
                        <span class="pf-hint">Must be unique across all patients.</span>
                    </div>

                    <!-- First / Last name (two columns) -->
                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="FirstName" class="pf-label">First Name <span class="pf-required">*</span></label>
                            <input asp-for="FirstName" class="pf-input" placeholder="e.g. Jane" />
                            <span asp-validation-for="FirstName" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="LastName" class="pf-label">Last Name <span class="pf-required">*</span></label>
                            <input asp-for="LastName" class="pf-input" placeholder="e.g. Doe" />
                            <span asp-validation-for="LastName" class="pf-error"></span>
                        </div>
                    </div>

                    <!-- DOB / Email (two columns) -->
                    <div class="pf-grid-2">
                        <div class="pf-field">
                            <label asp-for="DateOfBirth" class="pf-label">Date of Birth <span class="pf-required">*</span></label>
                            <input asp-for="DateOfBirth" type="date" class="pf-input" />
                            <span asp-validation-for="DateOfBirth" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="Email" class="pf-label">Email Address <span class="pf-required">*</span></label>
                            <div class="pf-input-wrap">
                                <span class="pf-input-prefix">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                        <polyline points="22,6 12,13 2,6"/>
                                    </svg>
                                </span>
                                <input asp-for="Email" type="email" class="pf-input pf-input--prefixed"
                                       placeholder="patient@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="pf-error"></span>
                        </div>
                    </div>
                </div>

                <div class="pf-footer">
                    <a asp-action="Index" class="pf-btn-cancel">Cancel</a>
                    <button type="submit" class="btn-primary-dash">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Save Patient
                    </button>
                </div>
            </div>
        </div>

        <!-- Tips sidebar -->
        <div class="col-lg-4">
            <div class="dash-card pf-tips-card">
                <div class="pf-tips-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    Tips
                </div>
                <ul class="pf-tips-list">
                    <li>The <strong>MRN</strong> must be unique — use a consistent format like <code>MRN-YYYY-NNN</code>.</li>
                    <li>Double-check the <strong>date of birth</strong> before saving to avoid age calculation errors.</li>
                    <li>A valid <strong>email</strong> allows future notifications to be sent to the patient.</li>
                </ul>
            </div>
        </div>

    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
