@model IReadOnlyList<HospitalMS.Business.Models.PatientResponse>
@{
    ViewData["Title"] = "Patients";
    ViewData["ActivePage"] = "Patients";

    // Deterministic avatar colour from name
    string[] avatarPalette = ["#2e37a4","#0891b2","#7c3aed","#ea5c0a","#16a34a","#dc2626","#0e7490","#9333ea"];
    string AvatarColor(string name)
    {
        int h = 0;
        foreach (char c in name) h = c + ((h << 5) - h);
        return avatarPalette[Math.Abs(h) % avatarPalette.Length];
    }

    int Age(DateTime dob)
    {
        var today = DateTime.UtcNow;
        int a = today.Year - dob.Year;
        if (dob.Date > today.AddYears(-a)) a--;
        return a;
    }
}

<!-- ── Page header ── -->
<div class="page-header">
    <div>
        <h1 class="page-header-title">Patients List</h1>
        <div class="page-header-subtitle">
            Total Patients: <strong>@Model.Count</strong>
        </div>
    </div>
    <a asp-action="Create" class="btn-primary-dash">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        New Patient
    </a>
</div>

<!-- ── Toolbar ── -->
<div class="patients-toolbar">
    <div class="patients-search-wrap">
        <svg class="patients-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="patientSearch" class="patients-search-input"
               placeholder="Search by name, MRN or email…" autocomplete="off" />
        <button type="button" class="patients-search-clear d-none" id="searchClear" aria-label="Clear search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
    </div>
    <div id="searchResultCount" class="patients-result-count d-none"></div>
</div>

<!-- ── Main card ── -->
<div class="dash-card">
    @if (!Model.Any())
    {
        <!-- Empty state -->
        <div class="patients-empty">
            <div class="patients-empty-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <line x1="23" y1="11" x2="17" y2="11"/>
                    <line x1="20" y1="8" x2="20" y2="14"/>
                </svg>
            </div>
            <h3 class="patients-empty-title">No patients yet</h3>
            <p class="patients-empty-text">Get started by registering the first patient.</p>
            <a asp-action="Create" class="btn-primary-dash">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Add Patient
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="patients-table" id="patientsTable">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Age</th>
                        <th>Date of Birth</th>
                        <th>Email</th>
                        <th>MRN</th>
                        <th>Registered</th>
                        <th class="col-actions"></th>
                    </tr>
                </thead>
                <tbody id="patientsBody">
                    @foreach (var p in Model)
                    {
                        var initials = $"{p.FirstName[0]}{p.LastName[0]}".ToUpper();
                        var color    = AvatarColor(p.FirstName + p.LastName);
                        var age      = Age(p.DateOfBirth);
                        <tr class="patient-row"
                            data-name="@($"{p.FirstName} {p.LastName}".ToLower())"
                            data-mrn="@p.MedicalRecordNumber.ToLower()"
                            data-email="@p.Email.ToLower()">
                            <td>
                                <div class="pt-name-cell">
                                    <div class="pt-avatar" style="background:@color">@initials</div>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@p.Id" class="pt-fullname text-decoration-none text-reset">
                                            @p.FirstName @p.LastName
                                        </a>
                                        <div class="pt-mrn-sub">@p.MedicalRecordNumber</div>
                                    </div>
                                </div>
                            </td>
                            <td class="pt-age">@age yrs</td>
                            <td>@p.DateOfBirth.ToString("MMM d, yyyy")</td>
                            <td>
                                <a href="mailto:@p.Email" class="pt-email-link">@p.Email</a>
                            </td>
                            <td><span class="pt-mrn-badge">@p.MedicalRecordNumber</span></td>
                            <td class="pt-registered">@p.CreatedAtUtc.ToString("MMM d, yyyy")</td>
                            <td class="col-actions">
                                <div class="dropdown">
                                    <button class="pt-actions-btn" type="button"
                                            data-bs-toggle="dropdown" aria-expanded="false"
                                            aria-label="Patient actions">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                            <circle cx="12" cy="5"  r="1.5"/>
                                            <circle cx="12" cy="12" r="1.5"/>
                                            <circle cx="12" cy="19" r="1.5"/>
                                        </svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end pt-dropdown shadow-sm">
                                        <li>
                                            <a class="dropdown-item pt-dropdown-item"
                                               asp-action="Details" asp-route-id="@p.Id">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                    <circle cx="12" cy="12" r="3"/>
                                                </svg>
                                                View Profile
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item pt-dropdown-item"
                                               asp-action="Edit" asp-route-id="@p.Id">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                                Edit Patient
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <button type="button" class="dropdown-item pt-dropdown-item pt-dropdown-danger"
                                                    onclick="confirmDelete('@p.Id', '@p.FirstName @p.LastName')">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                    <path d="M10 11v6"/><path d="M14 11v6"/>
                                                    <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                                </svg>
                                                Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- No-search-results row (hidden until needed) -->
        <div id="noResults" class="patients-no-results d-none">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <p>No patients match <strong id="noResultsTerm"></strong></p>
        </div>

        <!-- Table footer -->
        <div class="patients-table-footer">
            <span id="footerCount">Showing <strong>@Model.Count</strong> patient@(Model.Count == 1 ? "" : "s")</span>
        </div>
    }
</div>

<!-- Hidden delete form (submitted programmatically) -->
<form id="deleteForm" method="post" style="display:none">
    @Html.AntiForgeryToken()
</form>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px">
        <div class="modal-content" style="border:none;border-radius:16px;overflow:hidden">
            <div class="modal-body p-4 text-center">
                <div class="delete-modal-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                    </svg>
                </div>
                <h5 class="mt-3 mb-1" style="font-weight:700;color:#1e293b">Delete Patient</h5>
                <p class="text-muted mb-4" style="font-size:.875rem">
                    Are you sure you want to delete <strong id="deletePatientName"></strong>?
                    This action cannot be undone.
                </p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light px-4" style="border-radius:8px;font-weight:600"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger px-4"
                            style="border-radius:8px;font-weight:600">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Search filtering ──────────────────────────────────────────────────
        const searchInput   = document.getElementById('patientSearch');
        const searchClear   = document.getElementById('searchClear');
        const resultCount   = document.getElementById('searchResultCount');
        const noResults     = document.getElementById('noResults');
        const noResultsTerm = document.getElementById('noResultsTerm');
        const footerCount   = document.getElementById('footerCount');
        const rows          = document.querySelectorAll('.patient-row');
        const total         = rows.length;

        function filterTable() {
            const q = searchInput.value.trim().toLowerCase();
            searchClear.classList.toggle('d-none', q === '');

            let visible = 0;
            rows.forEach(row => {
                const match = !q
                    || row.dataset.name.includes(q)
                    || row.dataset.mrn.includes(q)
                    || row.dataset.email.includes(q);
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });

            const hasQuery = q !== '';
            noResults.classList.toggle('d-none', !hasQuery || visible > 0);
            resultCount.classList.toggle('d-none', !hasQuery);
            if (hasQuery) {
                noResultsTerm.textContent = `"${searchInput.value.trim()}"`;
                resultCount.textContent = visible === 0
                    ? 'No results'
                    : `${visible} of ${total} patient${total === 1 ? '' : 's'}`;
            }
            if (footerCount) {
                const shown = hasQuery ? visible : total;
                footerCount.innerHTML = `Showing <strong>${shown}</strong> patient${shown === 1 ? '' : 's'}`;
            }
        }

        searchInput.addEventListener('input', filterTable);
        searchClear.addEventListener('click', () => { searchInput.value = ''; filterTable(); searchInput.focus(); });

        // ── Delete modal ──────────────────────────────────────────────────────
        let pendingDeleteId = null;
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        function confirmDelete(id, name) {
            pendingDeleteId = id;
            document.getElementById('deletePatientName').textContent = name;
            deleteModal.show();
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', () => {
            if (!pendingDeleteId) return;
            const form = document.getElementById('deleteForm');
            form.action = `/patients/${pendingDeleteId}/delete`;
            deleteModal.hide();
            form.submit();
        });
    </script>
}
