@model HospitalMS.Business.Models.RevenueReport
@{
    Layout = "_Layout";
    ViewData["Title"] = "Revenue Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Revenue Report</h2>
    <a asp-controller="Reports" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">&larr; Dashboard</a>
</div>

@if (Model is null) { <div class="alert alert-warning">Unable to load report.</div> }
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Total Revenue Collected</div>
                    <div class="fs-2 fw-bold text-success">$@Model.TotalRevenue.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Outstanding Balance</div>
                    <div class="fs-2 fw-bold text-danger">$@Model.OutstandingBalance.ToString("N2")</div>
                    <div class="text-muted small">unpaid invoices</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent fw-semibold">Revenue by Payment Method</div>
                <div class="card-body">
                    @if (!Model.ByPaymentMethod.Any())
                    {
                        <p class="text-muted small">No data available.</p>
                    }
                    else
                    {
                        var total = Model.ByPaymentMethod.Sum(x => x.Amount);
                        @foreach (var m in Model.ByPaymentMethod.OrderByDescending(x => x.Amount))
                        {
                            var pct = total > 0 ? (double)(m.Amount / total) * 100 : 0;
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@m.Label</span>
                                <span class="fw-semibold">$@m.Amount.ToString("N2")</span>
                            </div>
                            <div class="progress mb-2" style="height:6px;">
                                <div class="progress-bar bg-success" style="width:@pct%"></div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent fw-semibold">Monthly Revenue — Last 12 Months</div>
                <div class="card-body">
                    @if (!Model.RevenuePerMonth.Any())
                    {
                        <p class="text-muted small">No data for the past 12 months.</p>
                    }
                    else
                    {
                        var maxRev = Model.RevenuePerMonth.Max(m => m.Revenue);
                        <div class="d-flex align-items-end gap-1" style="height:120px;">
                            @foreach (var m in Model.RevenuePerMonth)
                            {
                                var barHeight = maxRev > 0 ? (double)(m.Revenue / maxRev) * 100 : 0;
                                <div class="d-flex flex-column align-items-center flex-fill"
                                     title="@m.MonthLabel: $@m.Revenue.ToString("N0")">
                                    <div class="bg-success rounded-top w-100" style="height:@(barHeight)px; min-height:2px;"></div>
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-1 mt-1">
                            @foreach (var m in Model.RevenuePerMonth)
                            {
                                <div class="flex-fill text-center text-muted" style="font-size:9px;">@m.MonthLabel[5..]</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
