@model HospitalMS.Business.Models.CreateAppointmentRequest
@using HospitalMS.Data.Persistence.Entities
@{
    ViewData["Title"] = "New Appointment";
    ViewData["ActivePage"] = "Appointments";

    var patients = ViewBag.Patients as IReadOnlyList<HospitalMS.Business.Models.PatientResponse> ?? [];
    var doctors  = ViewBag.Doctors  as IReadOnlyList<HospitalMS.Business.Models.UserSummary>    ?? [];
}

<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-controller="Dashboard" asp-action="Index" class="pf-breadcrumb-link">Dashboard</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <a asp-action="Index" class="pf-breadcrumb-link">Appointments</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">New Appointment</span>
        </div>
        <h1 class="page-header-title">New Appointment</h1>
    </div>
    <a asp-action="Index" class="pf-back-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Back
    </a>
</div>

<form asp-action="Create" method="post" novalidate>
    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="dash-card">
                <div class="pf-section-header">
                    <div class="pf-section-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                    </div>
                    <div>
                        <div class="pf-section-title">Appointment Details</div>
                        <div class="pf-section-subtitle">Select patient, doctor, date and type.</div>
                    </div>
                </div>

                <div class="pf-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="PatientId" class="pf-label">Patient <span class="pf-required">*</span></label>
                            <select asp-for="PatientId" class="pf-input">
                                <option value="">— Select patient —</option>
                                @foreach (var p in patients)
                                {
                                    <option value="@p.Id">@p.FirstName @p.LastName (@p.MedicalRecordNumber)</option>
                                }
                            </select>
                            <span asp-validation-for="PatientId" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="DoctorUserId" class="pf-label">Doctor <span class="pf-required">*</span></label>
                            <select asp-for="DoctorUserId" class="pf-input">
                                <option value="">— Select doctor —</option>
                                @foreach (var d in doctors)
                                {
                                    <option value="@d.Id">@d.Username (@d.Role)</option>
                                }
                            </select>
                            <span asp-validation-for="DoctorUserId" class="pf-error"></span>
                        </div>
                    </div>

                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="ScheduledAtUtc" class="pf-label">Date &amp; Time (UTC) <span class="pf-required">*</span></label>
                            <input asp-for="ScheduledAtUtc" type="datetime-local" class="pf-input" />
                            <span asp-validation-for="ScheduledAtUtc" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="DurationMinutes" class="pf-label">Duration (minutes)</label>
                            <input asp-for="DurationMinutes" type="number" class="pf-input" min="5" max="480" />
                            <span asp-validation-for="DurationMinutes" class="pf-error"></span>
                        </div>
                    </div>

                    <div class="pf-field mb-4">
                        <label asp-for="Type" class="pf-label">Appointment Type</label>
                        <select asp-for="Type" class="pf-input">
                            @foreach (var t in AppointmentType.All)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>

                    <div class="pf-field mb-4">
                        <label asp-for="Reason" class="pf-label">Reason</label>
                        <textarea asp-for="Reason" class="pf-input" rows="2" placeholder="Chief reason for visit…"></textarea>
                    </div>

                    <div class="pf-field">
                        <label asp-for="Notes" class="pf-label">Notes</label>
                        <textarea asp-for="Notes" class="pf-input" rows="2" placeholder="Any additional notes…"></textarea>
                    </div>
                </div>

                <div class="pf-footer">
                    <a asp-action="Index" class="pf-btn-cancel">Cancel</a>
                    <button type="submit" class="btn-primary-dash">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Book Appointment
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dash-card pf-tips-card">
                <div class="pf-tips-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    Tips
                </div>
                <ul class="pf-tips-list">
                    <li>Scheduled time is in <strong>UTC</strong> — convert from local time if needed.</li>
                    <li>Default duration is <strong>30 minutes</strong>. Adjust for procedures or consultations.</li>
                    <li>An appointment can be linked to a <strong>clinical encounter</strong> once the patient arrives.</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
