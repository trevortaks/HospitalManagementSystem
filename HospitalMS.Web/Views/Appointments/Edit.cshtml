@model HospitalMS.Business.Models.UpdateAppointmentRequest
@using HospitalMS.Data.Persistence.Entities
@{
    ViewData["Title"] = "Edit Appointment";
    ViewData["ActivePage"] = "Appointments";

    var appointment = ViewBag.Appointment as HospitalMS.Business.Models.AppointmentResponse;
    var apptId = ViewBag.AppointmentId is Guid g ? g : Guid.Empty;
}

<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-controller="Dashboard" asp-action="Index" class="pf-breadcrumb-link">Dashboard</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <a asp-action="Index" class="pf-breadcrumb-link">Appointments</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">Edit</span>
        </div>
        <h1 class="page-header-title">Edit Appointment</h1>
    </div>
    <a asp-action="Index" class="pf-back-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Back
    </a>
</div>

@if (appointment is not null)
{
    <div class="alert alert-light border mb-4" style="border-radius:10px;font-size:.875rem">
        <strong>@appointment.PatientName</strong> (@appointment.PatientMrn) &mdash; Dr. @appointment.DoctorName &mdash;
        <span class="appt-status-badge appt-badge--@appointment.Status.ToLower()">@appointment.Status</span>
    </div>
}

<form asp-action="Edit" method="post" novalidate>
    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="dash-card">
                <div class="pf-section-header">
                    <div class="pf-section-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="pf-section-title">Appointment Details</div>
                        <div class="pf-section-subtitle">Update the schedule and notes.</div>
                    </div>
                </div>

                <div class="pf-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="ScheduledAtUtc" class="pf-label">Date &amp; Time (UTC) <span class="pf-required">*</span></label>
                            <input asp-for="ScheduledAtUtc" type="datetime-local" class="pf-input" />
                            <span asp-validation-for="ScheduledAtUtc" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="DurationMinutes" class="pf-label">Duration (minutes)</label>
                            <input asp-for="DurationMinutes" type="number" class="pf-input" min="5" max="480" />
                        </div>
                    </div>

                    <div class="pf-field mb-4">
                        <label asp-for="Type" class="pf-label">Appointment Type</label>
                        <select asp-for="Type" class="pf-input">
                            @foreach (var t in AppointmentType.All)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>

                    <div class="pf-field mb-4">
                        <label asp-for="Reason" class="pf-label">Reason</label>
                        <textarea asp-for="Reason" class="pf-input" rows="2" placeholder="Chief reason for visit…"></textarea>
                    </div>

                    <div class="pf-field">
                        <label asp-for="Notes" class="pf-label">Notes</label>
                        <textarea asp-for="Notes" class="pf-input" rows="2" placeholder="Additional notes…"></textarea>
                    </div>
                </div>

                <div class="pf-footer">
                    <a asp-action="Index" class="pf-btn-cancel">Cancel</a>
                    <button type="submit" class="btn-primary-dash">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Save Changes
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-4 d-flex flex-column gap-3">
            <div class="dash-card pf-tips-card">
                <div class="pf-tips-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    Quick Links
                </div>
                <ul class="pf-tips-list">
                    @if (appointment is not null)
                    {
                        <li>
                            <a asp-controller="Encounters" asp-action="Create"
                               asp-route-patientId="@appointment.PatientId"
                               asp-route-appointmentId="@apptId"
                               style="color:#2e37a4;font-weight:600">
                                Open Clinical Encounter
                            </a> for this appointment.
                        </li>
                    }
                    <li>To cancel this appointment, use the Cancel option from the appointments list.</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
