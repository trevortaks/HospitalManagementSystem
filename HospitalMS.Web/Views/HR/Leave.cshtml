@model List<HospitalMS.Business.Models.LeaveRequestResponse>
@using HospitalMS.Data.Persistence.Entities
@{
    Layout = "_Layout";
    ViewData["Title"] = "Leave Requests";
    var currentStatus = ViewData["CurrentStatus"] as string ?? "";

    string StatusBadge(string s) => s switch {
        LeaveRequestStatus.Pending  => "bg-warning text-dark",
        LeaveRequestStatus.Approved => "bg-success",
        LeaveRequestStatus.Rejected => "bg-danger",
        _                           => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Leave Requests</h2>
    <div class="d-flex gap-2">
        <a asp-action="Employees" class="btn btn-outline-secondary btn-sm">&larr; Employees</a>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createModal">+ Request Leave</button>
    </div>
</div>

<div class="d-flex gap-2 mb-3">
    <a asp-action="Leave" class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-dark" : "btn-outline-dark")">All</a>
    @foreach (var s in new[] { LeaveRequestStatus.Pending, LeaveRequestStatus.Approved, LeaveRequestStatus.Rejected, LeaveRequestStatus.Cancelled })
    {
        <a asp-action="Leave" asp-route-status="@s"
           class="btn btn-sm @(currentStatus == s ? "btn-dark" : "btn-outline-secondary")">@s</a>
    }
</div>

<div class="card border-0 shadow-sm">
    @if (!Model.Any())
    {
        <div class="card-body text-center text-muted py-5">No leave requests found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Type</th>
                        <th>From</th>
                        <th>To</th>
                        <th class="text-center">Days</th>
                        <th>Status</th>
                        <th>Requested</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td class="fw-semibold small">@l.EmployeeName</td>
                            <td><span class="badge bg-light text-dark border">@l.LeaveType</span></td>
                            <td class="small">@l.StartDate.ToString("dd MMM yyyy")</td>
                            <td class="small">@l.EndDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center small fw-semibold">@l.DurationDays</td>
                            <td><span class="badge @StatusBadge(l.Status)">@l.Status</span></td>
                            <td class="small text-muted">@l.RequestedAtUtc.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (l.Status == LeaveRequestStatus.Pending)
                                {
                                    <div class="d-flex gap-1">
                                        <form asp-action="ReviewLeave" asp-route-id="@l.Id" method="post">
                                            <input type="hidden" name="Approved" value="True" />
                                            <button type="submit" class="btn btn-xs btn-outline-success"
                                                    style="font-size:11px; padding:2px 6px;">Approve</button>
                                        </form>
                                        <form asp-action="ReviewLeave" asp-route-id="@l.Id" method="post">
                                            <input type="hidden" name="Approved" value="False" />
                                            <button type="submit" class="btn btn-xs btn-outline-danger"
                                                    style="font-size:11px; padding:2px 6px;">Reject</button>
                                        </form>
                                        <form asp-action="CancelLeave" asp-route-id="@l.Id" method="post">
                                            <button type="submit" class="btn btn-xs btn-outline-secondary"
                                                    style="font-size:11px; padding:2px 6px;">Cancel</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small">@Model.Count request(s)</div>
    }
</div>

<!-- Request Leave Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CreateLeave" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-semibold">Request Leave</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Employee Record ID *</label>
                            <input name="EmployeeRecordId" class="form-control" required placeholder="Employee record UUID" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Leave Type *</label>
                            <select name="LeaveType" class="form-select">
                                @foreach (var t in LeaveType.All)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Start Date *</label>
                            <input name="StartDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">End Date *</label>
                            <input name="EndDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Reason</label>
                            <textarea name="Reason" class="form-control" rows="2" maxlength="1000"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </div>
        </form>
    </div>
</div>
