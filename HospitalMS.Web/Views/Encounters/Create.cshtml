@model HospitalMS.Business.Models.CreateEncounterRequest
@using HospitalMS.Data.Persistence.Entities
@{
    ViewData["Title"] = "New Encounter";
    ViewData["ActivePage"] = "Encounters";

    var patients = ViewBag.Patients as IReadOnlyList<HospitalMS.Business.Models.PatientResponse> ?? [];
    var doctors  = ViewBag.Doctors  as IReadOnlyList<HospitalMS.Business.Models.UserSummary>    ?? [];
    var prePatientId    = ViewBag.PreselectedPatientId as Guid?;
    var preAppointmentId = ViewBag.PreselectedAppointmentId as Guid?;
}

<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-controller="Dashboard" asp-action="Index" class="pf-breadcrumb-link">Dashboard</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <a asp-action="Index" class="pf-breadcrumb-link">Encounters</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">New Encounter</span>
        </div>
        <h1 class="page-header-title">New Clinical Encounter</h1>
    </div>
    <a asp-action="Index" class="pf-back-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Back
    </a>
</div>

<form asp-action="Create" method="post" novalidate>
    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="dash-card">
                <div class="pf-section-header">
                    <div class="pf-section-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                        </svg>
                    </div>
                    <div>
                        <div class="pf-section-title">Encounter Information</div>
                        <div class="pf-section-subtitle">Document the clinical encounter details.</div>
                    </div>
                </div>

                <div class="pf-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="PatientId" class="pf-label">Patient <span class="pf-required">*</span></label>
                            <select asp-for="PatientId" class="pf-input">
                                <option value="">— Select patient —</option>
                                @foreach (var p in patients)
                                {
                                    if (prePatientId.HasValue && prePatientId.Value == p.Id)
                                    {
                                        <option value="@p.Id" selected>@p.FirstName @p.LastName (@p.MedicalRecordNumber)</option>
                                    }
                                    else
                                    {
                                        <option value="@p.Id">@p.FirstName @p.LastName (@p.MedicalRecordNumber)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="PatientId" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="AttendingDoctorId" class="pf-label">Attending Doctor <span class="pf-required">*</span></label>
                            <select asp-for="AttendingDoctorId" class="pf-input">
                                <option value="">— Select doctor —</option>
                                @foreach (var d in doctors)
                                {
                                    <option value="@d.Id">@d.Username (@d.Role)</option>
                                }
                            </select>
                            <span asp-validation-for="AttendingDoctorId" class="pf-error"></span>
                        </div>
                    </div>

                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="EncounterType" class="pf-label">Encounter Type <span class="pf-required">*</span></label>
                            <select asp-for="EncounterType" class="pf-input">
                                @foreach (var t in EncounterType.All)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="pf-field">
                            <label asp-for="AppointmentId" class="pf-label">Linked Appointment (optional)</label>
                            <input asp-for="AppointmentId" class="pf-input"
                                   placeholder="Appointment UUID (optional)"
                                   value="@(preAppointmentId?.ToString() ?? "")" />
                        </div>
                    </div>

                    <div class="pf-field mb-4">
                        <label asp-for="ChiefComplaint" class="pf-label">Chief Complaint</label>
                        <textarea asp-for="ChiefComplaint" class="pf-input" rows="2"
                                  placeholder="Patient's main complaint in their own words…"></textarea>
                    </div>

                    <div class="pf-field mb-4">
                        <label asp-for="HistoryOfPresentIllness" class="pf-label">History of Present Illness</label>
                        <textarea asp-for="HistoryOfPresentIllness" class="pf-input" rows="3"
                                  placeholder="Onset, duration, character, aggravating/relieving factors…"></textarea>
                    </div>

                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="Examination" class="pf-label">Examination</label>
                            <textarea asp-for="Examination" class="pf-input" rows="3"
                                      placeholder="Physical exam findings…"></textarea>
                        </div>
                        <div class="pf-field">
                            <label asp-for="Assessment" class="pf-label">Assessment</label>
                            <textarea asp-for="Assessment" class="pf-input" rows="3"
                                      placeholder="Clinical impression / working diagnosis…"></textarea>
                        </div>
                    </div>

                    <div class="pf-field">
                        <label asp-for="Plan" class="pf-label">Plan</label>
                        <textarea asp-for="Plan" class="pf-input" rows="3"
                                  placeholder="Treatment plan, investigations ordered, follow-up…"></textarea>
                    </div>
                </div>

                <div class="pf-footer">
                    <a asp-action="Index" class="pf-btn-cancel">Cancel</a>
                    <button type="submit" class="btn-primary-dash">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Open Encounter
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dash-card pf-tips-card">
                <div class="pf-tips-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    Tips
                </div>
                <ul class="pf-tips-list">
                    <li>All fields except Patient, Doctor and Type can be edited after creation.</li>
                    <li>Vitals and diagnoses are added <strong>after</strong> the encounter is created.</li>
                    <li>Closing an encounter is <strong>irreversible</strong> — only close when documentation is complete.</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
