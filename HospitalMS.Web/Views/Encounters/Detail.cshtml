@model HospitalMS.Business.Models.EncounterResponse
@{
    ViewData["Title"] = "Encounter Detail";
    ViewData["ActivePage"] = "Encounters";

    // Mirror the API's role rules so we only offer actions that will succeed.
    var sessionRole      = Context.Session.GetString("role") ?? "";
    var canEditDiagnoses = !Model.IsClosed && (sessionRole is "Admin" or "Doctor");
    var canRecordVitals  = !Model.IsClosed && (sessionRole is "Admin" or "Doctor" or "Nurse");
}

<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-action="Index" asp-route-patientId="@Model.PatientId" class="pf-breadcrumb-link">Encounters</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">Detail</span>
        </div>
        <h1 class="page-header-title">Clinical Encounter</h1>
        <div class="page-header-subtitle">@Model.PatientName &bull; @Model.PatientMrn</div>
    </div>
    <div class="d-flex gap-2">
        @if (!Model.IsClosed)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="pf-back-btn">Edit</a>
            <form asp-action="Close" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-primary-dash" style="background:linear-gradient(135deg,#16a34a,#0891b2)"
                        onclick="return confirm('Close this encounter? This cannot be undone.')">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Close Encounter
                </button>
            </form>
        }
        else
        {
            <span class="appt-status-badge appt-badge--completed" style="font-size:.9rem;padding:.4rem .9rem">Closed</span>
        }
    </div>
</div>

<!-- Summary bar -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="dash-card" style="padding:1rem 1.25rem">
            <div class="stat-label">Type</div>
            <div class="stat-value" style="font-size:1.1rem">@Model.EncounterType</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="dash-card" style="padding:1rem 1.25rem">
            <div class="stat-label">Doctor</div>
            <div class="stat-value" style="font-size:1.1rem">@Model.AttendingDoctorName</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="dash-card" style="padding:1rem 1.25rem">
            <div class="stat-label">Started</div>
            <div class="stat-value" style="font-size:1.1rem">@Model.StartedAtUtc.ToString("MMM d, yyyy h:mm tt")</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="dash-card" style="padding:1rem 1.25rem">
            <div class="stat-label">Diagnoses</div>
            <div class="stat-value" style="font-size:1.1rem">@Model.Diagnoses.Count</div>
        </div>
    </div>
</div>

<div class="row g-4 align-items-start">
    <!-- SOAP notes -->
    <div class="col-lg-8">
        <div class="dash-card mb-4">
            <div class="pf-section-header">
                <div class="pf-section-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                    </svg>
                </div>
                <div>
                    <div class="pf-section-title">SOAP Notes</div>
                    <div class="pf-section-subtitle">Subjective, Objective, Assessment and Plan.</div>
                </div>
            </div>
            <div class="pf-body">
                @{
                    void SoapSection(string label, string? content) {
                        <div class="mb-4">
                            <div style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#64748b;margin-bottom:.35rem">@label</div>
                            <div style="color:#1e293b;font-size:.9rem;line-height:1.65;white-space:pre-wrap">@(string.IsNullOrWhiteSpace(content) ? "—" : content)</div>
                        </div>
                    }
                    SoapSection("Chief Complaint", Model.ChiefComplaint);
                    SoapSection("History of Present Illness", Model.HistoryOfPresentIllness);
                    SoapSection("Examination", Model.Examination);
                    SoapSection("Assessment", Model.Assessment);
                    SoapSection("Plan", Model.Plan);
                    if (!string.IsNullOrWhiteSpace(Model.FollowUpNotes))
                    {
                        SoapSection("Follow-up Notes", Model.FollowUpNotes);
                    }
                }
            </div>
        </div>

        <!-- Vital Signs -->
        <div class="dash-card">
            <div class="pf-section-header">
                <div class="pf-section-icon" style="background:#fef9c3;color:#ca8a04">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                    </svg>
                </div>
                <div class="flex-grow-1">
                    <div class="pf-section-title">Vital Signs (@Model.VitalSigns.Count)</div>
                    <div class="pf-section-subtitle">Recorded measurements for this encounter.</div>
                </div>
                @if (canRecordVitals)
                {
                    <button type="button" class="pf-back-btn" data-bs-toggle="modal" data-bs-target="#encounterVitalsModal">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Record Vitals
                    </button>
                }
            </div>
            <div class="pf-body">
                @if (!Model.VitalSigns.Any())
                {
                    <div class="text-muted small">No vitals recorded yet.</div>
                }
                else
                {
                    foreach (var v in Model.VitalSigns)
                    {
                        <div class="mb-3 p-3" style="background:#f8fafc;border-radius:10px;border:1px solid #e2e8f0">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span style="font-size:.8rem;font-weight:600;color:#64748b">
                                    @v.RecordedAtUtc.ToString("MMM d, yyyy h:mm tt") — @v.RecordedByName
                                </span>
                            </div>
                            <div class="row g-2">
                                @{
                                    void Vital(string label, string? value) {
                                        if (value is not null) {
                                            <div class="col-6 col-sm-4">
                                                <div style="font-size:.75rem;color:#94a3b8">@label</div>
                                                <div style="font-weight:600;font-size:.9rem;color:#1e293b">@value</div>
                                            </div>
                                        }
                                    }
                                    Vital("Height", v.HeightCm.HasValue ? $"{v.HeightCm} cm" : null);
                                    Vital("Weight", v.WeightKg.HasValue ? $"{v.WeightKg} kg" : null);
                                    Vital("Temp.", v.TemperatureCelsius.HasValue ? $"{v.TemperatureCelsius}°C" : null);
                                    Vital("BP", v.BloodPressureSystolic.HasValue && v.BloodPressureDiastolic.HasValue ? $"{v.BloodPressureSystolic}/{v.BloodPressureDiastolic} mmHg" : null);
                                    Vital("HR", v.HeartRateBpm.HasValue ? $"{v.HeartRateBpm} bpm" : null);
                                    Vital("RR", v.RespiratoryRate.HasValue ? $"{v.RespiratoryRate} /min" : null);
                                    Vital("SpO₂", v.OxygenSaturationPct.HasValue ? $"{v.OxygenSaturationPct}%" : null);
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(v.Notes))
                            {
                                <div class="mt-2" style="font-size:.8rem;color:#64748b">@v.Notes</div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Diagnoses sidebar -->
    <div class="col-lg-4">
        <div class="dash-card">
            <div class="pf-section-header">
                <div class="pf-section-icon" style="background:#fee2e2;color:#dc2626">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                </div>
                <div>
                    <div class="pf-section-title">Diagnoses (@Model.Diagnoses.Count)</div>
                </div>
            </div>
            <div class="pf-body">
                @if (!Model.Diagnoses.Any())
                {
                    <div class="text-muted small">No diagnoses recorded yet.</div>
                }
                else
                {
                    foreach (var d in Model.Diagnoses)
                    {
                        <div class="mb-3 p-3" style="background:#f8fafc;border-radius:10px;border:1px solid #e2e8f0">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div style="font-weight:700;font-size:.9rem;color:#1e293b">@d.IcdCode</div>
                                    <div style="font-size:.85rem;color:#475569">@d.Description</div>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="pt-mrn-badge" style="white-space:nowrap">@d.DiagnosisType</span>
                                    @if (canEditDiagnoses)
                                    {
                                        <form asp-action="RemoveDiagnosis" asp-route-id="@Model.Id" asp-route-diagnosisId="@d.Id" method="post" class="m-0">
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-1" title="Remove diagnosis"
                                                    aria-label="Remove diagnosis @d.IcdCode"
                                                    data-confirm="Remove diagnosis @d.IcdCode?">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/>
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }

                @if (canEditDiagnoses)
                {
                    <form asp-action="AddDiagnosis" asp-route-id="@Model.Id" method="post" class="mt-3 pt-3" style="border-top:1px solid #e2e8f0">
                        <div style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#64748b;margin-bottom:.5rem">Add Diagnosis</div>
                        <div class="row g-2">
                            <div class="col-5">
                                <label class="form-label small fw-semibold mb-1" for="dxIcd">ICD-10 code</label>
                                <input id="dxIcd" name="IcdCode" class="form-control form-control-sm" placeholder="e.g. J06.9" maxlength="16" required />
                            </div>
                            <div class="col-7">
                                <label class="form-label small fw-semibold mb-1" for="dxType">Type</label>
                                <select id="dxType" name="DiagnosisType" class="form-select form-select-sm">
                                    @foreach (var t in HospitalMS.Data.Persistence.Entities.DiagnosisTypes.All)
                                    {
                                        <option value="@t" selected="@(t == (Model.Diagnoses.Any() ? "Secondary" : "Primary"))">@t</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold mb-1" for="dxDesc">Description</label>
                                <input id="dxDesc" name="Description" class="form-control form-control-sm" placeholder="e.g. Acute upper respiratory infection" maxlength="500" required />
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-sm w-100">Add Diagnosis</button>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@if (canRecordVitals)
{
    <div class="modal fade" id="encounterVitalsModal" tabindex="-1" aria-labelledby="encounterVitalsTitle">
        <div class="modal-dialog modal-lg">
            <form asp-action="AddVitals" asp-route-id="@Model.Id" method="post">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fw-semibold" id="encounterVitalsTitle">Record Vitals — @Model.PatientName</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Blood Pressure (mmHg)</label>
                                <div class="input-group">
                                    <input name="BloodPressureSystolic" type="number" class="form-control" placeholder="Systolic" min="50" max="250" aria-label="Systolic" />
                                    <span class="input-group-text">/</span>
                                    <input name="BloodPressureDiastolic" type="number" class="form-control" placeholder="Diastolic" min="30" max="150" aria-label="Diastolic" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold" for="evTemp">Temperature (°C)</label>
                                <input id="evTemp" name="TemperatureCelsius" type="number" step="0.1" class="form-control" placeholder="e.g. 36.6" min="32" max="43" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold" for="evHr">Heart Rate (bpm)</label>
                                <input id="evHr" name="HeartRateBpm" type="number" class="form-control" placeholder="e.g. 72" min="20" max="250" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold" for="evWeight">Weight (kg)</label>
                                <input id="evWeight" name="WeightKg" type="number" step="0.1" class="form-control" placeholder="e.g. 70.5" min="1" max="300" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold" for="evHeight">Height (cm)</label>
                                <input id="evHeight" name="HeightCm" type="number" step="0.1" class="form-control" placeholder="e.g. 170" min="30" max="250" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold" for="evRr">Respiratory Rate (/min)</label>
                                <input id="evRr" name="RespiratoryRate" type="number" class="form-control" placeholder="e.g. 16" min="4" max="60" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold" for="evSpo2">Oxygen Saturation (%)</label>
                                <input id="evSpo2" name="OxygenSaturationPct" type="number" step="0.1" class="form-control" placeholder="e.g. 98.5" min="50" max="100" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold" for="evNotes">Notes</label>
                                <textarea id="evNotes" name="Notes" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4">Save Vitals</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}
