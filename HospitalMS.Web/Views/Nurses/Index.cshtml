@model List<HospitalMS.Business.Models.UserSummary>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nurses";
    var activeCount   = Model.Count(n => n.IsActive);
    var inactiveCount = Model.Count(n => !n.IsActive);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Nurses</h2>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createModal">
        + Add Nurse
    </button>
</div>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Total Nurses</div>
                <div class="fs-2 fw-bold">@Model.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Active</div>
                <div class="fs-2 fw-bold text-success">@activeCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-1">Inactive</div>
                <div class="fs-2 fw-bold text-secondary">@inactiveCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    @if (!Model.Any())
    {
        <div class="card-body text-center text-muted py-5">
            No nurse accounts found. Use the <strong>Add Nurse</strong> button to create one.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Email / Phone</th>
                        <th>Specialization / Ward</th>
                        <th class="text-center">Status</th>
                        <th>Joined</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var nurse in Model.OrderBy(n => n.Username))
                    {
                        <tr class="@(nurse.IsActive ? "" : "table-secondary opacity-75")">
                            <td>
                                <a asp-action="Details" asp-route-id="@nurse.Id" class="fw-semibold text-decoration-none">@nurse.Username</a>
                                @if (!string.IsNullOrWhiteSpace(nurse.FirstName) || !string.IsNullOrWhiteSpace(nurse.LastName))
                                {
                                    <div class="small text-muted">@nurse.FirstName @nurse.LastName</div>
                                }
                            </td>
                            <td class="text-muted small">
                                <div>@nurse.Email</div>
                                @if (!string.IsNullOrWhiteSpace(nurse.PhoneNumber))
                                {
                                    <div>@nurse.PhoneNumber</div>
                                }
                            </td>
                            <td class="text-muted small">
                                @if (!string.IsNullOrWhiteSpace(nurse.Specialization))
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">@nurse.Specialization</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @(nurse.IsActive ? "bg-success" : "bg-secondary")">
                                    @(nurse.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="small text-muted">@nurse.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@nurse.Id"
                                       class="btn btn-sm btn-outline-secondary">View</a>
                                    <a asp-action="Edit" asp-route-id="@nurse.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <form asp-action="Toggle" asp-route-id="@nurse.Id" method="post">
                                        <button type="submit"
                                                class="btn btn-sm @(nurse.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                            @(nurse.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small">@Model.Count nurse(s)</div>
    }
</div>

<!-- Add Nurse Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-semibold">Add Nurse Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Username *</label>
                        <input name="Username" class="form-control" required maxlength="100"
                               placeholder="e.g. nurse.jane" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Email *</label>
                        <input name="Email" type="email" class="form-control" required maxlength="256" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Password *</label>
                        <input name="Password" type="password" class="form-control" required minlength="8" />
                        <div class="form-text">Minimum 8 characters.</div>
                    </div>
                    <input type="hidden" name="Role" value="Nurse" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Account</button>
                </div>
            </div>
        </form>
    </div>
</div>
