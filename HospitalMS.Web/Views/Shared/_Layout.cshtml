@{
    var activePage = ViewData["ActivePage"]?.ToString() ?? "";
    var username = Context.Session.GetString("username") ?? "User";
    var role = Context.Session.GetString("role") ?? "";
    var initials = username.Length >= 2 ? username[..2].ToUpper() : username.ToUpper();

    // Mirrors the RoleBasedAuth rules on the API controllers
    bool Can(params string[] roles) => roles.Contains(role);

    var canPatients      = Can("Admin", "Doctor", "Nurse", "Receptionist");
    var canStaffAdmin    = Can("Admin");
    var canAppointments  = Can("Admin", "Doctor", "Nurse", "Receptionist");
    var canEncounters    = Can("Admin", "Doctor", "Nurse");
    var canMedications   = Can("Admin", "Doctor", "Nurse", "Pharmacist");
    var canPrescriptions = Can("Admin", "Doctor", "Pharmacist");
    var canLab           = Can("Admin", "Doctor", "Nurse", "LabTechnician");
    var canImaging       = Can("Admin", "Doctor", "Nurse", "Radiologist");
    var canInvoices      = Can("Admin", "AccountsManager", "Doctor", "Receptionist");
    var canChargeItems   = Can("Admin", "AccountsManager");
    var canInsurance     = Can("Admin", "AccountsManager");
    var canBeds          = Can("Admin", "Nurse", "Doctor", "Receptionist");
    var canInventory     = Can("Admin", "Pharmacist", "Nurse");
    var canSupplyChain   = Can("Admin", "Pharmacist", "AccountsManager");
    var canFacilities    = Can("Admin", "Nurse", "Doctor");
    var canQuality       = Can("Admin", "Doctor", "Nurse");
    var canHR            = Can("Admin", "HRManager");
    var canAudit         = Can("Admin");
    var canPredictive    = Can("Admin", "Doctor");
    var canReports       = Can("Admin", "Doctor", "AccountsManager");

    var showClinic   = canPatients || canStaffAdmin || canAppointments || canEncounters || canMedications || canPrescriptions || canLab || canImaging;
    var showFinance  = canInvoices || canChargeItems || canInsurance;
    var showFacility = canBeds || canInventory || canSupplyChain || canFacilities || canQuality;
    var showAdmin    = canAudit || canPredictive || canReports;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HospitalMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalMS.Web.styles.css" asp-append-version="true" />
</head>
<body class="dash-body" id="dashBody">

    <!-- Mobile overlay -->
    <div class="dash-overlay" id="dashOverlay" onclick="closeSidebar()"></div>

    <!-- ── Sidebar ── -->
    <aside class="dash-sidebar" id="sidebar">
        <a class="sidebar-logo" asp-controller="Dashboard" asp-action="Index">
            <div class="sidebar-logo-icon">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="7.5" y="1" width="5" height="18" rx="2" fill="white" />
                    <rect x="1" y="7.5" width="18" height="5" rx="2" fill="white" />
                </svg>
            </div>
            <span class="sidebar-logo-text">HospitalMS</span>
        </a>

        <div class="sidebar-scroll">

            <!-- Main -->
            <div class="sidebar-group">
                <div class="sidebar-group-label">Main</div>

                <a asp-controller="Dashboard" asp-action="Index"
                   class="sidebar-link @(activePage == "Dashboard" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                        <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                    </svg>
                    <span class="sidebar-link-text">Dashboard</span>
                </a>
            </div>

            <!-- Clinic -->
            @if (showClinic)
            {
            <div class="sidebar-group">
                <div class="sidebar-group-label">Clinic</div>

                @if (canPatients)
                {
                <a asp-controller="Patients" asp-action="Index"
                   class="sidebar-link @(activePage == "Patients" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    <span class="sidebar-link-text">Patients</span>
                </a>
                }

                @if (canStaffAdmin)
                {
                <a asp-controller="Doctors" asp-action="Index"
                   class="sidebar-link @(activePage == "Doctors" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>
                    </svg>
                    <span class="sidebar-link-text">Doctors</span>
                </a>

                <a asp-controller="Nurses" asp-action="Index"
                   class="sidebar-link @(activePage == "Nurses" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                        <line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/>
                    </svg>
                    <span class="sidebar-link-text">Nurses</span>
                </a>
                }

                @if (canAppointments)
                {
                <a asp-controller="Appointments" asp-action="Index"
                   class="sidebar-link @(activePage == "Appointments" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    <span class="sidebar-link-text">Appointments</span>
                </a>
                }

                @if (canEncounters)
                {
                <a asp-controller="Encounters" asp-action="Index"
                   class="sidebar-link @(activePage == "Encounters" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                    </svg>
                    <span class="sidebar-link-text">Encounters</span>
                </a>
                }

                @if (canMedications)
                {
                <a asp-controller="Medications" asp-action="Index"
                   class="sidebar-link @(activePage == "Medications" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2v-4M9 21H5a2 2 0 0 1-2-2v-4m0 0h18"/>
                    </svg>
                    <span class="sidebar-link-text">Medications</span>
                </a>
                }

                @if (canPrescriptions)
                {
                <a asp-controller="Prescriptions" asp-action="Index"
                   class="sidebar-link @(activePage == "Prescriptions" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                        <polyline points="10 9 9 9 8 9"/>
                    </svg>
                    <span class="sidebar-link-text">Prescriptions</span>
                </a>
                }

                @if (canLab)
                {
                <a asp-controller="Lab" asp-action="Orders"
                   class="sidebar-link @(activePage == "Lab" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18"/>
                        <path d="M5 21h14a2 2 0 0 0 2-2v-4M5 21a2 2 0 0 1-2-2v-4m0 0h18"/>
                    </svg>
                    <span class="sidebar-link-text">Lab Orders</span>
                </a>
                }

                @if (canImaging)
                {
                <a asp-controller="Imaging" asp-action="Index"
                   class="sidebar-link @(activePage == "Imaging" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    <span class="sidebar-link-text">Imaging</span>
                </a>
                }
            </div>
            }

            <!-- My Health (Patient self-service) -->
            @if (role == "Patient")
            {
                <div class="sidebar-group">
                    <div class="sidebar-group-label">My Health</div>

                    <a asp-controller="Portal" asp-action="Index"
                       class="sidebar-link @(activePage == "Portal" ? "active" : "")">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                            <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                        </svg>
                        <span class="sidebar-link-text">Overview</span>
                    </a>

                    <a asp-controller="Portal" asp-action="Appointments"
                       class="sidebar-link @(activePage == "Portal" && ViewData["Title"]?.ToString() == "My Appointments" ? "active" : "")">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        <span class="sidebar-link-text">My Appointments</span>
                    </a>

                    <a asp-controller="Portal" asp-action="Prescriptions"
                       class="sidebar-link @(activePage == "Portal" && ViewData["Title"]?.ToString() == "My Prescriptions" ? "active" : "")">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                        </svg>
                        <span class="sidebar-link-text">My Prescriptions</span>
                    </a>

                    <a asp-controller="Portal" asp-action="Profile"
                       class="sidebar-link @(activePage == "Portal" && ViewData["Title"]?.ToString() == "My Profile" ? "active" : "")">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        <span class="sidebar-link-text">My Profile</span>
                    </a>
                </div>
            }

            <!-- Finance -->
            @if (showFinance)
            {
            <div class="sidebar-group">
                <div class="sidebar-group-label">Finance</div>

                @if (canInvoices)
                {
                <a asp-controller="Billing" asp-action="Invoices"
                   class="sidebar-link @(activePage == "Billing" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                    <span class="sidebar-link-text">Invoices</span>
                </a>
                }

                @if (canChargeItems)
                {
                <a asp-controller="Billing" asp-action="ChargeItems"
                   class="sidebar-link @(activePage == "Billing" && ViewData["Title"]?.ToString() == "Charge Items" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"/>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    </svg>
                    <span class="sidebar-link-text">Charge Items</span>
                </a>
                }

                @if (canInsurance)
                {
                <a asp-controller="InsuranceWeb" asp-action="Providers"
                   class="sidebar-link @(activePage == "Insurance" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    <span class="sidebar-link-text">Insurance</span>
                </a>
                }
            </div>
            }

            <!-- Facility -->
            @if (showFacility)
            {
            <div class="sidebar-group">
                <div class="sidebar-group-label">Facility</div>

                @if (canBeds)
                {
                <a asp-controller="BedManagement" asp-action="Wards"
                   class="sidebar-link @(activePage == "Beds" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    <span class="sidebar-link-text">Wards &amp; Beds</span>
                </a>
                }

                @if (canInventory)
                {
                <a asp-controller="Inventory" asp-action="Items"
                   class="sidebar-link @(activePage == "Inventory" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                        <line x1="8" y1="18" x2="21" y2="18"/>
                        <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/>
                        <line x1="3" y1="18" x2="3.01" y2="18"/>
                    </svg>
                    <span class="sidebar-link-text">Inventory</span>
                </a>
                }

                @if (canSupplyChain)
                {
                <a asp-controller="SupplyChain" asp-action="Suppliers"
                   class="sidebar-link @(activePage == "SupplyChain" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                    <span class="sidebar-link-text">Supply Chain</span>
                </a>
                }

                @if (canFacilities)
                {
                <a asp-controller="Facilities" asp-action="Rooms"
                   class="sidebar-link @(activePage == "Facilities" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                        <path d="M8 21h8M12 17v4"/>
                    </svg>
                    <span class="sidebar-link-text">Facilities</span>
                </a>
                }

                @if (canQuality)
                {
                <a asp-controller="Quality" asp-action="Incidents"
                   class="sidebar-link @(activePage == "Quality" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                    <span class="sidebar-link-text">Quality</span>
                </a>
                }
            </div>
            }

            <!-- HR -->
            @if (canHR)
            {
            <div class="sidebar-group">
                <div class="sidebar-group-label">Human Resources</div>

                <a asp-controller="HR" asp-action="Employees"
                   class="sidebar-link @(activePage == "HR" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    <span class="sidebar-link-text">HR</span>
                </a>
            </div>
            }

            <!-- Administration -->
            @if (showAdmin)
            {
            <div class="sidebar-group">
                <div class="sidebar-group-label">Administration</div>

                @if (canAudit)
                {
                <a asp-controller="Audit" asp-action="Index"
                   class="sidebar-link @(activePage == "Audit" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 17l-5-5 5-5"/><path d="M18 17l-5-5 5-5"/>
                    </svg>
                    <span class="sidebar-link-text">Audit Log</span>
                </a>
                }

                @if (canPredictive)
                {
                <a asp-controller="Predictive" asp-action="Summary"
                   class="sidebar-link @(activePage == "Predictive" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                    </svg>
                    <span class="sidebar-link-text">Predictive</span>
                </a>
                }

                @if (canReports)
                {
                <a asp-controller="Reports" asp-action="Dashboard"
                   class="sidebar-link @(activePage == "Reports" ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
                        <line x1="6" y1="20" x2="6" y2="14"/>
                    </svg>
                    <span class="sidebar-link-text">Reports</span>
                </a>
                }

                @if (canAudit)
                {
                <a href="#" class="sidebar-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
                    </svg>
                    <span class="sidebar-link-text">Settings</span>
                    <span class="sidebar-badge">Soon</span>
                </a>
                }
            </div>
            }
        </div>

        <!-- Sidebar footer: logged-in user -->
        <div class="sidebar-footer">
            <div class="sidebar-user-avatar">@initials</div>
            <div class="sidebar-user-info">
                <div class="sidebar-user-name">@username</div>
                <div class="sidebar-user-role">@role</div>
            </div>
        </div>
    </aside>

    <!-- ── Main area ── -->
    <div class="dash-main">

        <!-- Topbar -->
        <header class="dash-topbar">
            <button class="topbar-toggle" id="sidebarToggle" aria-label="Toggle sidebar"
                    onclick="toggleSidebar()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>

            <div class="topbar-breadcrumb">
                <span>HospitalMS</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
                <span class="topbar-breadcrumb-current">@(ViewData["Title"] ?? "Dashboard")</span>
            </div>

            <div class="topbar-actions">
                <!-- Notification placeholder -->
                <button class="topbar-icon-btn" aria-label="Notifications">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                </button>

                <div class="topbar-divider"></div>

                <!-- User dropdown -->
                <div class="dropdown">
                    <div class="topbar-user" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="topbar-avatar">@initials</div>
                        <div class="topbar-user-info">
                            <div class="topbar-user-name">@username</div>
                            <div class="topbar-user-role">@role</div>
                        </div>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:#94a3b8;margin-left:.25rem">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-1 mt-1" style="min-width:180px;border-radius:10px">
                        <li><h6 class="dropdown-header" style="font-size:.72rem">Signed in as <strong>@username</strong></h6></li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline w-100">
                                <button type="submit" class="dropdown-item text-danger" style="font-size:.875rem">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:.4rem;vertical-align:-2px">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                        <polyline points="16 17 21 12 16 7"/>
                                        <line x1="21" y1="12" x2="9" y2="12"/>
                                    </svg>
                                    Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Page content -->
        <main class="dash-content" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            const body = document.getElementById('dashBody');
            const isMobile = window.innerWidth < 768;
            if (isMobile) {
                body.classList.toggle('sidebar-open');
            } else {
                body.classList.toggle('sidebar-collapsed');
                localStorage.setItem('sidebarCollapsed', body.classList.contains('sidebar-collapsed'));
            }
        }

        function closeSidebar() {
            document.getElementById('dashBody').classList.remove('sidebar-open');
        }

        // Restore desktop collapse state
        if (window.innerWidth >= 768 && localStorage.getItem('sidebarCollapsed') === 'true') {
            document.getElementById('dashBody').classList.add('sidebar-collapsed');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    @{
        var toastSuccess = TempData["SuccessMessage"] as string;
        var toastError   = TempData["Error"] as string;
    }
    @if (toastSuccess is not null || toastError is not null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1100" aria-live="polite">
            @if (toastSuccess is not null)
            {
                <div class="toast align-items-center text-bg-success border-0" role="alert" data-bs-autohide="true" data-bs-delay="4000">
                    <div class="d-flex">
                        <div class="toast-body">@toastSuccess</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            }
            @if (toastError is not null)
            {
                <div class="toast align-items-center text-bg-danger border-0" role="alert" data-bs-autohide="true" data-bs-delay="6000">
                    <div class="d-flex">
                        <div class="toast-body">@toastError</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            }
        </div>
        <script>
            document.querySelectorAll('.toast').forEach(function(el) {
                bootstrap.Toast.getOrCreateInstance(el).show();
            });
        </script>
    }
</body>
</html>
