@model IReadOnlyList<HospitalMS.Business.Models.MaintenanceRequestResponse>
@using HospitalMS.Business.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Maintenance Requests";
    var currentStatus = (string?)ViewBag.Status;
    var rooms    = (IReadOnlyList<RoomResponse>)ViewBag.Rooms;
    var equipment = (IReadOnlyList<EquipmentResponse>)ViewBag.Equipment;
    var staff    = (IReadOnlyList<UserSummary>)ViewBag.Staff;
    var statuses = new[] { "Open", "InProgress", "OnHold", "Resolved", "Closed" };
    var priorities = new[] { "Low", "Medium", "High", "Critical" };
    var reqTypes   = new[] { "Corrective", "Preventive", "Emergency", "Inspection" };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">Maintenance Requests</h2>
    <div class="d-flex gap-2">
        <a asp-controller="Facilities" asp-action="Rooms" class="btn btn-outline-secondary">Rooms</a>
        <a asp-controller="Facilities" asp-action="Equipment" class="btn btn-outline-secondary">Equipment</a>
        <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#createModal">+ New Request</button>
    </div>
</div>

<div class="d-flex gap-2 mb-4 flex-wrap">
    <a asp-controller="Facilities" asp-action="MaintenanceRequests"
       class="btn btn-sm @(currentStatus is null ? "btn-primary" : "btn-outline-secondary")">All</a>
    @foreach (var s in statuses)
    {
        var cls = s switch {
            "Open"       => "btn-outline-warning",
            "InProgress" => "btn-outline-info",
            "Resolved"   => "btn-outline-success",
            "Closed"     => "btn-outline-secondary",
            _            => "btn-outline-secondary"
        };
        <a asp-controller="Facilities" asp-action="MaintenanceRequests" asp-route-status="@s"
           class="btn btn-sm @(currentStatus == s ? "btn-primary" : cls)">@s</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No maintenance requests found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Title</th><th>Type</th><th>Priority</th><th>Target</th>
                    <th>Status</th><th>Requested</th><th>Assigned To</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var priorityClass = r.Priority switch {
                        "Critical" => "bg-danger",
                        "High"     => "bg-warning text-dark",
                        "Medium"   => "bg-info text-dark",
                        _          => "bg-secondary"
                    };
                    var statusClass = r.Status switch {
                        "Open"       => "bg-warning text-dark",
                        "InProgress" => "bg-info text-dark",
                        "Resolved"   => "bg-success",
                        "Closed"     => "bg-secondary",
                        _            => "bg-secondary"
                    };
                    <tr>
                        <td class="fw-semibold">@r.Title</td>
                        <td class="small text-muted">@r.RequestType</td>
                        <td><span class="badge @priorityClass">@r.Priority</span></td>
                        <td class="small">
                            @if (r.RoomName is not null) { <span>Room: @r.RoomName</span> }
                            @if (r.EquipmentName is not null) { <span>Equip: @r.EquipmentName</span> }
                        </td>
                        <td><span class="badge @statusClass">@r.Status</span></td>
                        <td class="small text-muted">@r.RequestedAtUtc.ToString("dd MMM")</td>
                        <td class="small">@(r.AssignedToUsername ?? "—")</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                @if (r.Status is "Open" or "InProgress")
                                {
                                    <form asp-controller="Facilities" asp-action="ResolveRequest"
                                          asp-route-id="@r.Id" method="post" class="d-inline">
                                        <input type="hidden" name="ResolutionNotes" value="Resolved" />
                                        <button class="btn btn-sm btn-success">Resolve</button>
                                    </form>
                                }
                                @if (r.Status == "Resolved")
                                {
                                    <form asp-controller="Facilities" asp-action="CloseRequest"
                                          asp-route-id="@r.Id" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-secondary">Close</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Create Request Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">New Maintenance Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <form asp-controller="Facilities" asp-action="CreateMaintenanceRequest" method="post">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Title</label>
                            <input name="Title" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea name="Description" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-semibold">Type</label>
                            <select name="RequestType" class="form-select">
                                @foreach (var t in reqTypes) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-semibold">Priority</label>
                            <select name="Priority" class="form-select">
                                @foreach (var p in priorities) { <option value="@p">@p</option> }
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-semibold">Requested By</label>
                            <select name="RequestedByUserId" class="form-select" required>
                                <option value="">Select...</option>
                                @foreach (var u in staff)
                                {
                                    <option value="@u.Id">@u.Username</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Room (optional)</label>
                            <select name="RoomId" class="form-select">
                                <option value="">None</option>
                                @foreach (var rm in rooms)
                                {
                                    <option value="@rm.Id">@rm.RoomNumber — @rm.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Equipment (optional)</label>
                            <select name="EquipmentId" class="form-select">
                                <option value="">None</option>
                                @foreach (var eq in equipment)
                                {
                                    <option value="@eq.Id">@eq.Code — @eq.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>
