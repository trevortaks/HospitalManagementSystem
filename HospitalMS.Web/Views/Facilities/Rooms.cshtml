@model IReadOnlyList<HospitalMS.Business.Models.RoomResponse>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Rooms";
    var roomTypes = new[] { "General", "OperatingTheatre", "ConsultationRoom", "ProcedureRoom",
                            "Laboratory", "ConferenceRoom", "Reception", "Storage", "Utility" };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">Rooms</h2>
    <div class="d-flex gap-2">
        <a asp-controller="Facilities" asp-action="MaintenanceRequests" class="btn btn-outline-warning">Maintenance</a>
        <a asp-controller="Facilities" asp-action="Equipment" class="btn btn-outline-primary">Equipment</a>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">+ Add Room</button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="fs-4 fw-bold">@Model.Count</div>
                <div class="text-muted small">Total Rooms</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="fs-4 fw-bold text-success">@Model.Count(r => r.IsActive)</div>
                <div class="text-muted small">Active</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="fs-4 fw-bold text-warning">@Model.Sum(r => r.OpenRequestCount)</div>
                <div class="text-muted small">Open Requests</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="fs-4 fw-bold">@Model.Sum(r => r.CapacityPersons)</div>
                <div class="text-muted small">Total Capacity</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No rooms registered yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Number</th><th>Name</th><th>Type</th><th>Floor</th><th>Building</th>
                    <th>Capacity</th><th>Open Requests</th><th>Status</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-semibold font-monospace">@r.RoomNumber</td>
                        <td>@r.Name</td>
                        <td><span class="badge bg-secondary">@r.RoomType</span></td>
                        <td>@r.FloorNumber</td>
                        <td class="text-muted">@(r.Building ?? "—")</td>
                        <td>@r.CapacityPersons</td>
                        <td>
                            @if (r.OpenRequestCount > 0)
                            {
                                <span class="badge bg-warning text-dark">@r.OpenRequestCount open</span>
                            }
                            else { <span class="text-muted small">—</span> }
                        </td>
                        <td>
                            <span class="badge @(r.IsActive ? "bg-success" : "bg-secondary")">
                                @(r.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <form asp-controller="Facilities" asp-action="ToggleRoom" asp-route-id="@r.Id"
                                  method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary">
                                    @(r.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Create Room Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Add Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <form asp-controller="Facilities" asp-action="CreateRoom" method="post">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-7">
                            <label class="form-label fw-semibold">Room Name</label>
                            <input name="Name" class="form-control" required />
                        </div>
                        <div class="col-5">
                            <label class="form-label fw-semibold">Room Number</label>
                            <input name="RoomNumber" class="form-control" required placeholder="A-101" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Type</label>
                            <select name="RoomType" class="form-select">
                                @foreach (var t in roomTypes) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div class="col-3">
                            <label class="form-label fw-semibold">Floor</label>
                            <input name="FloorNumber" type="number" class="form-control" value="1" min="1" />
                        </div>
                        <div class="col-3">
                            <label class="form-label fw-semibold">Capacity</label>
                            <input name="CapacityPersons" type="number" class="form-control" value="1" min="1" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Building (optional)</label>
                            <input name="Building" class="form-control" placeholder="Main Block" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Notes</label>
                            <textarea name="Notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Room</button>
                </div>
            </form>
        </div>
    </div>
</div>
