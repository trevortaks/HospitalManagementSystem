@model HospitalMS.Business.Models.PortalDashboardResponse?
@using HospitalMS.Data.Persistence.Entities
@{
    ViewData["Title"] = "My Health Portal";
    ViewData["ActivePage"] = "Portal";

    string StatusClass(string s) => s switch {
        AppointmentStatus.Completed  => "appt-badge--completed",
        AppointmentStatus.Cancelled  => "appt-badge--cancelled",
        AppointmentStatus.NoShow     => "appt-badge--noshow",
        AppointmentStatus.Confirmed  => "appt-badge--confirmed",
        AppointmentStatus.InProgress => "appt-badge--inprogress",
        _                             => "appt-badge--scheduled"
    };
    string RxStatusClass(string s) => s switch {
        PrescriptionStatus.Dispensed => "appt-badge--completed",
        PrescriptionStatus.Cancelled => "appt-badge--cancelled",
        PrescriptionStatus.Expired   => "appt-badge--noshow",
        _                             => "appt-badge--confirmed"
    };
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">My Health Portal</h1>
        @if (Model is not null)
        {
            <div class="page-header-subtitle">Welcome, <strong>@Model.Profile.FirstName @Model.Profile.LastName</strong></div>
        }
    </div>
</div>

@if (ViewBag.NoLinkedPatient == true || Model is null)
{
    <div class="dash-card" style="text-align:center;padding:3rem 2rem">
        <div class="patients-empty-icon" style="margin:0 auto 1rem">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
        </div>
        <h3 class="patients-empty-title">No patient record linked</h3>
        <p class="patients-empty-text">Your account is not yet linked to a patient record. Contact your care team to set this up.</p>
    </div>
    return;
}

<!-- Stats row -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="dash-card stat-card">
            <div class="stat-icon" style="background:#eff6ff;color:#3b82f6">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
            </div>
            <div>
                <div class="stat-value">@Model.UpcomingAppointments.Count</div>
                <div class="stat-label">Upcoming appointments</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card stat-card">
            <div class="stat-icon" style="background:#f0fdf4;color:#16a34a">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
            </div>
            <div>
                <div class="stat-value">@Model.ActivePrescriptions.Count</div>
                <div class="stat-label">Active prescriptions</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card stat-card">
            <div class="stat-icon" style="background:#fdf4ff;color:#a855f7">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                </svg>
            </div>
            <div>
                <div class="stat-value">@Model.TotalEncounters</div>
                <div class="stat-label">Total visits</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Upcoming appointments -->
    <div class="col-lg-6">
        <div class="dash-card">
            <div class="d-flex justify-content-between align-items-center" style="padding:1.25rem 1.5rem .75rem">
                <h6 class="mb-0 fw-600" style="color:#1e293b">Upcoming Appointments</h6>
                <a asp-action="Appointments" class="pf-hint" style="font-size:.8rem">View all →</a>
            </div>
            @if (!Model.UpcomingAppointments.Any())
            {
                <div style="padding:.75rem 1.5rem 1.5rem;color:#94a3b8;font-size:.875rem">No upcoming appointments.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="patients-table">
                        <tbody>
                            @foreach (var a in Model.UpcomingAppointments)
                            {
                                <tr>
                                    <td>
                                        <div class="pt-fullname">@a.ScheduledAtUtc.ToString("MMM d, yyyy")</div>
                                        <div class="pt-mrn-sub">@a.ScheduledAtUtc.ToString("HH:mm") — @a.DoctorName</div>
                                    </td>
                                    <td><span class="pt-mrn-badge">@a.Type</span></td>
                                    <td><span class="appt-status-badge @StatusClass(a.Status)">@a.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Active prescriptions -->
    <div class="col-lg-6">
        <div class="dash-card">
            <div class="d-flex justify-content-between align-items-center" style="padding:1.25rem 1.5rem .75rem">
                <h6 class="mb-0 fw-600" style="color:#1e293b">Active Prescriptions</h6>
                <a asp-action="Prescriptions" class="pf-hint" style="font-size:.8rem">View all →</a>
            </div>
            @if (!Model.ActivePrescriptions.Any())
            {
                <div style="padding:.75rem 1.5rem 1.5rem;color:#94a3b8;font-size:.875rem">No active prescriptions.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="patients-table">
                        <tbody>
                            @foreach (var rx in Model.ActivePrescriptions)
                            {
                                <tr>
                                    <td>
                                        <div class="pt-fullname">
                                            @rx.MedicationGenericName
                                            @if (rx.IsControlled)
                                            {
                                                <span class="appt-status-badge" style="background:#fef3c7;color:#b45309;font-size:.65rem;margin-left:.25rem">Ctrl</span>
                                            }
                                        </div>
                                        @if (rx.MedicationBrandName is not null)
                                        {
                                            <div class="pt-mrn-sub">@rx.MedicationBrandName</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="pt-fullname">@rx.Dose</div>
                                        <div class="pt-mrn-sub">@rx.Frequency</div>
                                    </td>
                                    <td><span class="appt-status-badge @RxStatusClass(rx.Status)">@rx.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
