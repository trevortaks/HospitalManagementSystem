@model IReadOnlyList<HospitalMS.Business.Models.PortalAppointmentResponse>
@using HospitalMS.Data.Persistence.Entities
@{
    ViewData["Title"] = "My Appointments";
    ViewData["ActivePage"] = "Portal";

    string StatusClass(string s) => s switch {
        AppointmentStatus.Completed  => "appt-badge--completed",
        AppointmentStatus.Cancelled  => "appt-badge--cancelled",
        AppointmentStatus.NoShow     => "appt-badge--noshow",
        AppointmentStatus.Confirmed  => "appt-badge--confirmed",
        AppointmentStatus.InProgress => "appt-badge--inprogress",
        _                             => "appt-badge--scheduled"
    };
}

<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-action="Index" class="pf-breadcrumb-link">My Health Portal</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">My Appointments</span>
        </div>
        <h1 class="page-header-title">My Appointments</h1>
        <div class="page-header-subtitle">Total: <strong>@Model.Count</strong></div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <button type="button" class="btn-primary-dash" data-bs-toggle="modal" data-bs-target="#bookApptModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Book Appointment
        </button>
        <a asp-action="Index" class="pf-back-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
            </svg>
            Portal Home
        </a>
    </div>
</div>

<div class="dash-card">
    @if (!Model.Any())
    {
        <div class="patients-empty">
            <div class="patients-empty-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
            </div>
            <h3 class="patients-empty-title">No appointments</h3>
            <p class="patients-empty-text">You have no appointment records.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="patients-table">
                <thead>
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Doctor</th>
                        <th>Type</th>
                        <th>Reason</th>
                        <th>Duration</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>
                                <div class="pt-fullname">@a.ScheduledAtUtc.ToString("MMM d, yyyy")</div>
                                <div class="pt-mrn-sub">@a.ScheduledAtUtc.ToString("HH:mm")</div>
                            </td>
                            <td>@a.DoctorName</td>
                            <td><span class="pt-mrn-badge">@a.Type</span></td>
                            <td>@(a.Reason ?? "—")</td>
                            <td>@a.DurationMinutes min</td>
                            <td><span class="appt-status-badge @StatusClass(a.Status)">@a.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="patients-table-footer">
            <span>Showing <strong>@Model.Count</strong> appointment@(Model.Count == 1 ? "" : "s")</span>
        </div>
    }
</div>

<!-- Book Appointment Modal -->
<div class="modal fade" id="bookApptModal" tabindex="-1" aria-labelledby="bookApptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Portal" asp-action="BookAppointment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="bookApptModalLabel">Book New Appointment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Doctor <span class="text-danger">*</span></label>
                            <select name="DoctorUserId" id="doctorSelect" class="form-select" required>
                                <option value="">Loading doctors…</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date &amp; Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="ScheduledAtUtc" class="form-control" required
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")T00:00" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Duration</label>
                            <select name="DurationMinutes" class="form-select">
                                <option value="15">15 minutes</option>
                                <option value="30" selected>30 minutes</option>
                                <option value="45">45 minutes</option>
                                <option value="60">60 minutes</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Type</label>
                            <select name="Type" class="form-select">
                                <option value="General">General</option>
                                <option value="FollowUp">Follow-Up</option>
                                <option value="Emergency">Emergency</option>
                                <option value="Procedure">Procedure</option>
                                <option value="Teleconsult">Teleconsult</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Reason for visit</label>
                            <textarea name="Reason" class="form-control" rows="3" placeholder="Briefly describe your symptoms or reason for the appointment…"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="pf-back-btn" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-dash">Request Appointment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('bookApptModal').addEventListener('show.bs.modal', function () {
        var sel = document.getElementById('doctorSelect');
        if (sel.options.length > 1) return; // already loaded
        fetch('/portal/doctors')
            .then(function(r) { return r.json(); })
            .then(function(doctors) {
                sel.innerHTML = '<option value="">Select a doctor…</option>';
                doctors.forEach(function(d) {
                    var opt = document.createElement('option');
                    opt.value = d.id;
                    opt.textContent = d.name;
                    sel.appendChild(opt);
                });
            })
            .catch(function() {
                sel.innerHTML = '<option value="">Failed to load doctors</option>';
            });
    });
</script>
}
