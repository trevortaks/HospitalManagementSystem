@model HospitalMS.Web.Models.DashboardViewModel
@using HospitalMS.Business.Models
@{
    ViewData["Title"]      = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";

    string RoleBadgeClass(string role) => role switch
    {
        "Admin"     => "badge-admin",
        "Doctor"    => "badge-doctor",
        "Nurse"     => "badge-nurse",
        _           => "badge-default"
    };

    string StaffAvatarColor(string role) => role switch
    {
        "Doctor"    => "linear-gradient(135deg,#0891b2,#06b6d4)",
        "Nurse"     => "linear-gradient(135deg,#16a34a,#22c55e)",
        "Admin"     => "linear-gradient(135deg,#2e37a4,#0e9fd4)",
        "HRManager" => "linear-gradient(135deg,#ea5c0a,#f97316)",
        _           => "linear-gradient(135deg,#7c3aed,#a78bfa)"
    };
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Dashboard</h1>
        <div class="page-header-subtitle">@DateTime.UtcNow.ToString("dddd, MMMM d, yyyy") — Admin Overview</div>
    </div>
    <a asp-controller="Patients" asp-action="Create" class="btn btn-sm"
       style="background:linear-gradient(135deg,#2e37a4,#0e9fd4);color:white;border:none;border-radius:8px;padding:.5rem 1rem;font-weight:600;font-size:.85rem">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align:-2px;margin-right:.35rem">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        New Patient
    </a>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@Model.TotalPatients</div>
                <div class="stat-label">Total Patients</div>
                @if (Model.Summary is not null)
                {
                    <div class="stat-sub text-success">+@Model.Summary.NewPatientsThisMonth this month</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--teal">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@(Model.Summary?.AppointmentsToday ?? 0)</div>
                <div class="stat-label">Appointments Today</div>
                @if (Model.Summary is not null)
                {
                    <div class="stat-sub text-muted">@Model.Summary.AppointmentsThisWeek this week</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--orange">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@(Model.Summary?.OccupiedBeds ?? 0)<span style="font-size:1rem;color:var(--text-muted)">/@(Model.Summary?.TotalBeds ?? 0)</span></div>
                <div class="stat-label">Beds Occupied</div>
                @if (Model.Summary is not null && Model.Summary.TotalBeds > 0)
                {
                    <div class="stat-sub text-muted">@Model.Summary.OccupancyRate.ToString("0")% occupancy</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--purple">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-value" style="font-size:1.4rem">@(Model.Summary?.OutstandingInvoiceBalance.ToString("C0") ?? "$0")</div>
                <div class="stat-label">Outstanding Balance</div>
                @if (Model.Summary is not null && Model.Summary.LowStockItemCount > 0)
                {
                    <div class="stat-sub text-danger">@Model.Summary.LowStockItemCount low stock items</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Second row: staff counts -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--teal">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>
                </svg>
            </div>
            <div class="stat-body"><div class="stat-value">@Model.TotalDoctors</div><div class="stat-label">Doctors</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--green">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    <line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/>
                </svg>
            </div>
            <div class="stat-body"><div class="stat-value">@Model.TotalNurses</div><div class="stat-label">Nurses</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--blue">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
            </div>
            <div class="stat-body"><div class="stat-value">@Model.HRSummary?.ActiveEmployees</div><div class="stat-label">Active Employees</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--orange">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@Model.HRSummary?.PendingLeaveRequests</div>
                <div class="stat-label">Pending Leave Requests</div>
            </div>
        </div>
    </div>
</div>

<!-- Bottom row -->
<div class="row g-3">
    <div class="col-lg-8">
        <div class="dash-card h-100">
            <div class="dash-card-header">
                <h2 class="dash-card-title">Recent Patients</h2>
                <a asp-controller="Patients" asp-action="Index" class="dash-card-action">View all</a>
            </div>
            @if (!Model.RecentPatients.Any())
            {
                <div class="dash-empty">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                    </svg>
                    <p>No patients registered yet.<br><a asp-controller="Patients" asp-action="Create">Add the first patient</a></p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="dash-table">
                        <thead>
                            <tr><th>Patient</th><th>MRN</th><th>DOB</th><th>Blood Group</th><th>Registered</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.RecentPatients)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Patients" asp-action="Details" asp-route-id="@p.Id"
                                           class="fw-semibold text-decoration-none">@p.FirstName @p.LastName</a>
                                    </td>
                                    <td><span class="patient-mrn">@p.MedicalRecordNumber</span></td>
                                    <td>@p.DateOfBirth.ToString("MMM d, yyyy")</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(p.BloodGroup))
                                        {
                                            <span class="badge bg-danger bg-opacity-15 text-danger">@p.BloodGroup</span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td style="color:var(--text-muted);font-size:.8rem">@p.CreatedAtUtc.ToString("MMM d")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="dash-card h-100">
            <div class="dash-card-header">
                <h2 class="dash-card-title">Staff</h2>
                <span style="font-size:.78rem;color:var(--text-muted)">@Model.TotalStaff total</span>
            </div>
            @if (!Model.RecentStaff.Any())
            {
                <div class="dash-empty">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>
                    </svg>
                    <p>No staff registered yet.</p>
                </div>
            }
            else
            {
                @foreach (var u in Model.RecentStaff)
                {
                    <div class="staff-item">
                        <div class="staff-avatar" style="background:@StaffAvatarColor(u.Role)">
                            @(u.Username.Length >= 2 ? u.Username[..2].ToUpper() : u.Username.ToUpper())
                        </div>
                        <div class="staff-info">
                            <div class="staff-name">@(!string.IsNullOrWhiteSpace(u.FirstName) ? $"{u.FirstName} {u.LastName}".Trim() : u.Username)</div>
                            <div class="staff-username">@u.Email</div>
                        </div>
                        <span class="badge-role @RoleBadgeClass(u.Role)">@u.Role</span>
                    </div>
                }
            }
        </div>
    </div>
</div>
