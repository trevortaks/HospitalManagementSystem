@model HospitalMS.Web.Models.DashboardViewModel
@using HospitalMS.Business.Models
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";

    string RoleBadgeClass(string role) => role switch
    {
        "Admin"        => "badge-admin",
        "Doctor"       => "badge-doctor",
        "Nurse"        => "badge-nurse",
        "Receptionist" => "badge-receptionist",
        "Pharmacist"   => "badge-pharmacist",
        _              => "badge-default"
    };

    string StaffAvatarColor(string role) => role switch
    {
        "Doctor"   => "linear-gradient(135deg,#0891b2,#06b6d4)",
        "Nurse"    => "linear-gradient(135deg,#ea5c0a,#f97316)",
        "Admin"    => "linear-gradient(135deg,#2e37a4,#0e9fd4)",
        _          => "linear-gradient(135deg,#7c3aed,#a78bfa)"
    };
}

<!-- Page header -->
<div class="page-header">
    <div>
        <h1 class="page-header-title">Dashboard</h1>
        <div class="page-header-subtitle">@DateTime.UtcNow.ToString("dddd, MMMM d, yyyy") &mdash; Overview</div>
    </div>
    <a asp-controller="Patients" asp-action="Create" class="btn btn-sm"
       style="background:linear-gradient(135deg,#2e37a4,#0e9fd4);color:white;border:none;border-radius:8px;padding:.5rem 1rem;font-weight:600;font-size:.85rem">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align:-2px;margin-right:.35rem">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        New Patient
    </a>
</div>

<!-- ── Stat cards ── -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@Model.TotalPatients</div>
                <div class="stat-label">Total Patients</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--teal">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 7h-9"/><path d="M14 17H5"/>
                    <circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@Model.TotalDoctors</div>
                <div class="stat-label">Doctors</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--orange">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@Model.TotalNurses</div>
                <div class="stat-label">Nurses</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon--purple">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@Model.TotalStaff</div>
                <div class="stat-label">Total Staff</div>
            </div>
        </div>
    </div>
</div>

<!-- ── Bottom row: recent patients + staff ── -->
<div class="row g-3">

    <!-- Recent Patients table -->
    <div class="col-lg-8">
        <div class="dash-card h-100">
            <div class="dash-card-header">
                <h2 class="dash-card-title">Recent Patients</h2>
                <a asp-controller="Patients" asp-action="Index" class="dash-card-action">View all</a>
            </div>
            @if (!Model.RecentPatients.Any())
            {
                <div class="dash-empty">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                    </svg>
                    <p>No patients registered yet.<br><a asp-controller="Patients" asp-action="Create">Add the first patient</a></p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>MRN</th>
                                <th>Date of Birth</th>
                                <th>Email</th>
                                <th>Registered</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.RecentPatients)
                            {
                                <tr>
                                    <td>
                                        <span class="patient-name">@p.FirstName @p.LastName</span>
                                    </td>
                                    <td><span class="patient-mrn">@p.MedicalRecordNumber</span></td>
                                    <td>@p.DateOfBirth.ToString("MMM d, yyyy")</td>
                                    <td>@p.Email</td>
                                    <td style="color:var(--text-muted);font-size:.8rem">@p.CreatedAtUtc.ToString("MMM d")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Staff list -->
    <div class="col-lg-4">
        <div class="dash-card h-100">
            <div class="dash-card-header">
                <h2 class="dash-card-title">Staff</h2>
                <span style="font-size:.78rem;color:var(--text-muted)">@Model.TotalStaff total</span>
            </div>
            @if (!Model.RecentStaff.Any())
            {
                <div class="dash-empty">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M20 7h-9"/><path d="M14 17H5"/>
                        <circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>
                    </svg>
                    <p>No staff registered yet.</p>
                </div>
            }
            else
            {
                @foreach (var u in Model.RecentStaff)
                {
                    <div class="staff-item">
                        <div class="staff-avatar" style="background:@StaffAvatarColor(u.Role)">
                            @(u.Username.Length >= 2 ? u.Username[..2].ToUpper() : u.Username.ToUpper())
                        </div>
                        <div class="staff-info">
                            <div class="staff-name">@u.Username</div>
                            <div class="staff-username">@u.Email</div>
                        </div>
                        <span class="badge-role @RoleBadgeClass(u.Role)">@u.Role</span>
                    </div>
                }
            }
        </div>
    </div>
</div>
