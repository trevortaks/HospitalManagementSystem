@model HospitalMS.Business.Models.CreateLabOrderRequest
@using HospitalMS.Data.Persistence.Entities
@{
    ViewData["Title"] = "New Lab Order";
    ViewData["ActivePage"] = "Lab";
    var panels  = ViewBag.Panels  as IReadOnlyList<HospitalMS.Business.Models.LabOrderPanelResponse> ?? [];
    var doctors = ViewBag.Doctors as IReadOnlyList<HospitalMS.Business.Models.UserSummary>           ?? [];
    var preEncounterId = ViewBag.PreselectedEncounterId as Guid?;
    var prePatientId   = ViewBag.PreselectedPatientId   as Guid?;
}

<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-action="Orders" class="pf-breadcrumb-link">Lab Orders</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">New Order</span>
        </div>
        <h1 class="page-header-title">New Lab Order</h1>
    </div>
    <a asp-action="Orders" class="pf-back-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back
    </a>
</div>

<form asp-action="CreateOrder" method="post" novalidate>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="dash-card">
                <div class="pf-section-header">
                    <div class="pf-section-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18"/></svg>
                    </div>
                    <div>
                        <div class="pf-section-title">Order Details</div>
                    </div>
                </div>
                <div class="pf-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>
                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="EncounterId" class="pf-label">Encounter ID <span class="pf-required">*</span></label>
                            <input asp-for="EncounterId" class="pf-input" value="@(preEncounterId?.ToString() ?? "")" placeholder="Encounter UUID" />
                            <span asp-validation-for="EncounterId" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="PatientId" class="pf-label">Patient ID <span class="pf-required">*</span></label>
                            <input asp-for="PatientId" class="pf-input" value="@(prePatientId?.ToString() ?? "")" placeholder="Patient UUID" />
                            <span asp-validation-for="PatientId" class="pf-error"></span>
                        </div>
                    </div>
                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="OrderedByUserId" class="pf-label">Ordered By <span class="pf-required">*</span></label>
                            <select asp-for="OrderedByUserId" class="pf-input">
                                <option value="">— Select doctor —</option>
                                @foreach (var d in doctors)
                                {
                                    <option value="@d.Id">@d.Username (@d.Role)</option>
                                }
                            </select>
                            <span asp-validation-for="OrderedByUserId" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="PanelId" class="pf-label">Panel <span class="pf-required">*</span></label>
                            <select asp-for="PanelId" class="pf-input">
                                <option value="">— Select panel —</option>
                                @foreach (var panel in panels)
                                {
                                    <option value="@panel.Id">[@panel.Code] @panel.Name@(panel.Category is not null ? $" — {panel.Category}" : "")</option>
                                }
                            </select>
                            <span asp-validation-for="PanelId" class="pf-error"></span>
                        </div>
                    </div>
                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="Priority" class="pf-label">Priority</label>
                            <select asp-for="Priority" class="pf-input">
                                @foreach (var pri in LabOrderPriority.All)
                                {
                                    <option value="@pri">@pri</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="pf-field">
                        <label asp-for="Notes" class="pf-label">Notes</label>
                        <textarea asp-for="Notes" class="pf-input" rows="2" placeholder="Clinical notes for the lab…"></textarea>
                    </div>
                </div>
                <div class="pf-footer">
                    <a asp-action="Orders" class="pf-btn-cancel">Cancel</a>
                    <button type="submit" class="btn-primary-dash">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        Place Order
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
