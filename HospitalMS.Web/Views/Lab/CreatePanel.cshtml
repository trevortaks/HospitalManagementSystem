@model HospitalMS.Business.Models.CreateLabOrderPanelRequest
@{
    ViewData["Title"] = "Add Lab Panel";
    ViewData["ActivePage"] = "Lab";
}

<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-action="Panels" class="pf-breadcrumb-link">Lab Panels</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">Add Panel</span>
        </div>
        <h1 class="page-header-title">Add Lab Panel</h1>
    </div>
    <a asp-action="Panels" class="pf-back-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back
    </a>
</div>

<form asp-action="CreatePanel" method="post" novalidate>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="dash-card">
                <div class="pf-section-header">
                    <div class="pf-section-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2v-4M9 21H5a2 2 0 0 1-2-2v-4m0 0h18"/></svg>
                    </div>
                    <div>
                        <div class="pf-section-title">Panel Details</div>
                        <div class="pf-section-subtitle">A panel groups related lab tests under a single order.</div>
                    </div>
                </div>
                <div class="pf-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>
                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="Code" class="pf-label">Code <span class="pf-required">*</span></label>
                            <input asp-for="Code" class="pf-input" placeholder="e.g. FBC, LFT, U&E" />
                            <span asp-validation-for="Code" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="Name" class="pf-label">Name <span class="pf-required">*</span></label>
                            <input asp-for="Name" class="pf-input" placeholder="e.g. Full Blood Count" />
                            <span asp-validation-for="Name" class="pf-error"></span>
                        </div>
                    </div>
                    <div class="pf-field mb-4">
                        <label asp-for="Category" class="pf-label">Category</label>
                        <input asp-for="Category" class="pf-input" placeholder="e.g. Haematology, Biochemistry, Microbiology" />
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" type="checkbox" class="form-check-input" id="IsActive" checked />
                        <label class="form-check-label pf-label" for="IsActive">Active in catalogue</label>
                    </div>
                </div>
                <div class="pf-footer">
                    <a asp-action="Panels" class="pf-btn-cancel">Cancel</a>
                    <button type="submit" class="btn-primary-dash">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        Save Panel
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
