@{
    ViewData["Title"] = "New Invoice";
    ViewData["ActivePage"] = "Billing";
    var staff = ViewBag.Staff as IReadOnlyList<HospitalMS.Business.Models.UserSummary> ?? [];
    var prePatientId   = ViewBag.PreselectedPatientId   as Guid?;
    var preEncounterId = ViewBag.PreselectedEncounterId as Guid?;
}

<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-action="Invoices" class="pf-breadcrumb-link">Invoices</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">New Invoice</span>
        </div>
        <h1 class="page-header-title">New Invoice</h1>
    </div>
    <a asp-action="Invoices" class="pf-back-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back
    </a>
</div>

<form asp-action="CreateInvoice" method="post" novalidate>
    <div class="dash-card">
        <div class="pf-section-header">
            <div class="pf-section-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div><div class="pf-section-title">Invoice Details</div></div>
        </div>
        <div class="pf-body">
            <div class="pf-grid-2 mb-4">
                <div class="pf-field">
                    <label for="PatientId" class="pf-label">Patient ID <span class="pf-required">*</span></label>
                    <input id="PatientId" name="PatientId" class="pf-input" value="@(prePatientId?.ToString() ?? "")" placeholder="Patient UUID" required />
                </div>
                <div class="pf-field">
                    <label for="EncounterId" class="pf-label">Encounter ID <span style="color:#94a3b8">(optional)</span></label>
                    <input id="EncounterId" name="EncounterId" class="pf-input" value="@(preEncounterId?.ToString() ?? "")" placeholder="Encounter UUID" />
                </div>
            </div>
            <div class="pf-grid-2 mb-4">
                <div class="pf-field">
                    <label for="CreatedByUserId" class="pf-label">Created By <span class="pf-required">*</span></label>
                    <select id="CreatedByUserId" name="CreatedByUserId" class="pf-input" required>
                        <option value="">— Select staff member —</option>
                        @foreach (var u in staff)
                        {
                            <option value="@u.Id">@u.Username (@u.Role)</option>
                        }
                    </select>
                </div>
                <div class="pf-field">
                    <label for="DueDate" class="pf-label">Due Date</label>
                    <input id="DueDate" name="DueDate" type="date" class="pf-input" />
                </div>
            </div>
            <div class="pf-field">
                <label for="Notes" class="pf-label">Notes</label>
                <textarea id="Notes" name="Notes" class="pf-input" rows="2" placeholder="Invoice notes…"></textarea>
            </div>
        </div>
        <div class="pf-footer">
            <a asp-action="Invoices" class="pf-btn-cancel">Cancel</a>
            <button type="submit" class="btn-primary-dash">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                Create Invoice
            </button>
        </div>
    </div>
</form>
