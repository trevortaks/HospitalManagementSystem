@{
    ViewData["Title"] = "New Charge Item";
    ViewData["ActivePage"] = "Billing";
}

<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-action="ChargeItems" class="pf-breadcrumb-link">Charge Items</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">New Item</span>
        </div>
        <h1 class="page-header-title">New Charge Item</h1>
    </div>
    <a asp-action="ChargeItems" class="pf-back-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back
    </a>
</div>

<form asp-action="CreateChargeItem" method="post" novalidate>
    <div class="dash-card" style="max-width:640px">
        <div class="pf-body">
            <div class="pf-grid-2 mb-4">
                <div class="pf-field">
                    <label for="Code" class="pf-label">Code <span class="pf-required">*</span></label>
                    <input id="Code" name="Code" class="pf-input" placeholder="e.g. CONSULT-GP" required />
                </div>
                <div class="pf-field">
                    <label for="Category" class="pf-label">Category</label>
                    <input id="Category" name="Category" class="pf-input" placeholder="e.g. Consultation, Lab, Radiology" />
                </div>
            </div>
            <div class="pf-field mb-4">
                <label for="Description" class="pf-label">Description <span class="pf-required">*</span></label>
                <input id="Description" name="Description" class="pf-input" placeholder="Service description" required />
            </div>
            <div class="pf-grid-2 mb-4">
                <div class="pf-field">
                    <label for="UnitPrice" class="pf-label">Unit Price <span class="pf-required">*</span></label>
                    <input id="UnitPrice" name="UnitPrice" type="number" step="0.01" min="0" class="pf-input" placeholder="0.00" required />
                </div>
                <div class="pf-field d-flex align-items-end gap-2">
                    <div class="form-check form-switch" style="padding-top:2rem">
                        <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="true" checked />
                        <label class="form-check-label pf-label" for="IsActive">Active</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="pf-footer">
            <a asp-action="ChargeItems" class="pf-btn-cancel">Cancel</a>
            <button type="submit" class="btn-primary-dash">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                Save Item
            </button>
        </div>
    </div>
</form>
