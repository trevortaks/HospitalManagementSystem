@model HospitalMS.Business.Models.CreateMedicationRequest
@using HospitalMS.Data.Persistence.Entities
@{
    ViewData["Title"] = "Add Medication";
    ViewData["ActivePage"] = "Medications";
}

<div class="page-header">
    <div>
        <div class="pf-breadcrumb">
            <a asp-controller="Dashboard" asp-action="Index" class="pf-breadcrumb-link">Dashboard</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <a asp-action="Index" class="pf-breadcrumb-link">Medications</a>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="pf-breadcrumb-current">Add Medication</span>
        </div>
        <h1 class="page-header-title">Add Medication</h1>
    </div>
    <a asp-action="Index" class="pf-back-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Back
    </a>
</div>

<form asp-action="Create" method="post" novalidate>
    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="dash-card">
                <div class="pf-section-header">
                    <div class="pf-section-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"/>
                            <path d="M12 8v8"/><path d="M8 12h8"/>
                        </svg>
                    </div>
                    <div>
                        <div class="pf-section-title">Medication Details</div>
                        <div class="pf-section-subtitle">Enter the drug information for the catalogue.</div>
                    </div>
                </div>

                <div class="pf-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="GenericName" class="pf-label">Generic Name <span class="pf-required">*</span></label>
                            <input asp-for="GenericName" class="pf-input" placeholder="e.g. Amoxicillin" />
                            <span asp-validation-for="GenericName" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="BrandName" class="pf-label">Brand Name</label>
                            <input asp-for="BrandName" class="pf-input" placeholder="e.g. Amoxil" />
                        </div>
                    </div>

                    <div class="pf-grid-2 mb-4">
                        <div class="pf-field">
                            <label asp-for="Form" class="pf-label">Form <span class="pf-required">*</span></label>
                            <select asp-for="Form" class="pf-input">
                                <option value="">— Select form —</option>
                                @foreach (var f in MedicationForm.All)
                                {
                                    <option value="@f">@f</option>
                                }
                            </select>
                            <span asp-validation-for="Form" class="pf-error"></span>
                        </div>
                        <div class="pf-field">
                            <label asp-for="Strength" class="pf-label">Strength</label>
                            <input asp-for="Strength" class="pf-input" placeholder="e.g. 500 mg" />
                        </div>
                    </div>

                    <div class="pf-field mb-4">
                        <label asp-for="RouteOfAdministration" class="pf-label">Route of Administration</label>
                        <select asp-for="RouteOfAdministration" class="pf-input">
                            <option value="">— Select route —</option>
                            @foreach (var r in MedicationRoute.All)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex gap-4 mb-2">
                        <div class="form-check form-switch">
                            <input asp-for="IsControlled" type="checkbox" class="form-check-input" id="IsControlled" />
                            <label class="form-check-label pf-label" for="IsControlled">Controlled Substance</label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" id="IsActive" checked />
                            <label class="form-check-label pf-label" for="IsActive">Active in Catalogue</label>
                        </div>
                    </div>
                </div>

                <div class="pf-footer">
                    <a asp-action="Index" class="pf-btn-cancel">Cancel</a>
                    <button type="submit" class="btn-primary-dash">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Save Medication
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dash-card pf-tips-card">
                <div class="pf-tips-header">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    Tips
                </div>
                <ul class="pf-tips-list">
                    <li>Use the <strong>generic (INN) name</strong> as the primary identifier.</li>
                    <li>Mark controlled substances accurately — they appear flagged on prescriptions.</li>
                    <li>Inactive medications remain in history but cannot be newly prescribed.</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
