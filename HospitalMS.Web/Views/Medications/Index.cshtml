@model IReadOnlyList<HospitalMS.Business.Models.MedicationResponse>
@{
    ViewData["Title"] = "Medications";
    ViewData["ActivePage"] = "Medications";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Medications Catalogue</h1>
        <div class="page-header-subtitle">Total: <strong>@Model.Count</strong></div>
    </div>
    <a asp-action="Create" class="btn-primary-dash">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Add Medication
    </a>
</div>

<!-- Search toolbar -->
<div class="patients-toolbar">
    <div class="patients-search-wrap">
        <svg class="patients-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="medSearch" class="patients-search-input" placeholder="Search by name, brand or form…" autocomplete="off" />
        <button type="button" class="patients-search-clear d-none" id="searchClear">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
    </div>
</div>

<div class="dash-card">
    @if (!Model.Any())
    {
        <div class="patients-empty">
            <div class="patients-empty-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"/>
                    <path d="M12 8v8"/><path d="M8 12h8"/>
                </svg>
            </div>
            <h3 class="patients-empty-title">No medications yet</h3>
            <p class="patients-empty-text">Add the first medication to the catalogue.</p>
            <a asp-action="Create" class="btn-primary-dash">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Add Medication
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="patients-table" id="medTable">
                <thead>
                    <tr>
                        <th>Generic Name</th>
                        <th>Brand</th>
                        <th>Form</th>
                        <th>Strength</th>
                        <th>Route</th>
                        <th>Controlled</th>
                        <th>Status</th>
                        <th class="col-actions"></th>
                    </tr>
                </thead>
                <tbody id="medBody">
                    @foreach (var m in Model)
                    {
                        <tr class="patient-row med-row"
                            data-name="@m.GenericName.ToLower()"
                            data-brand="@(m.BrandName?.ToLower() ?? "")"
                            data-form="@m.Form.ToLower()">
                            <td>
                                <div class="pt-fullname">@m.GenericName</div>
                            </td>
                            <td>@(m.BrandName ?? "—")</td>
                            <td><span class="pt-mrn-badge">@m.Form</span></td>
                            <td>@(m.Strength ?? "—")</td>
                            <td>@(m.RouteOfAdministration ?? "—")</td>
                            <td>
                                @if (m.IsControlled)
                                {
                                    <span class="appt-status-badge" style="background:#fef3c7;color:#b45309">Controlled</span>
                                }
                                else
                                {
                                    <span style="color:#94a3b8;font-size:.8rem">No</span>
                                }
                            </td>
                            <td>
                                @if (m.IsActive)
                                {
                                    <span class="appt-status-badge appt-badge--confirmed">Active</span>
                                }
                                else
                                {
                                    <span class="appt-status-badge appt-badge--cancelled">Inactive</span>
                                }
                            </td>
                            <td class="col-actions">
                                <div class="dropdown">
                                    <button class="pt-actions-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                            <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                                        </svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end pt-dropdown shadow-sm">
                                        <li>
                                            <a class="dropdown-item pt-dropdown-item" asp-action="Edit" asp-route-id="@m.Id">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                                Edit
                                            </a>
                                        </li>
                                        <li>
                                            <form asp-action="ToggleActive" asp-route-id="@m.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item pt-dropdown-item @(m.IsActive ? "pt-dropdown-danger" : "")">
                                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        @if (m.IsActive)
                                                        {
                                                            <path d="M18 6L6 18"/><path d="M6 6l12 12"/>
                                                        }
                                                        else
                                                        {
                                                            <polyline points="20 6 9 17 4 12"/>
                                                        }
                                                    </svg>
                                                    @(m.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="noResults" class="patients-no-results d-none">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <p>No medications match <strong id="noResultsTerm"></strong></p>
        </div>
        <div class="patients-table-footer">
            <span id="footerCount">Showing <strong>@Model.Count</strong> medication@(Model.Count == 1 ? "" : "s")</span>
        </div>
    }
</div>

@section Scripts {
    <script>
        const rows = document.querySelectorAll('.med-row');
        const searchInput = document.getElementById('medSearch');
        const searchClear = document.getElementById('searchClear');
        const noResults = document.getElementById('noResults');
        const noResultsTerm = document.getElementById('noResultsTerm');
        const footerCount = document.getElementById('footerCount');

        function filter() {
            const q = searchInput.value.trim().toLowerCase();
            searchClear.classList.toggle('d-none', q === '');
            let visible = 0;
            rows.forEach(row => {
                const match = !q || row.dataset.name.includes(q) || row.dataset.brand.includes(q) || row.dataset.form.includes(q);
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            noResults.classList.toggle('d-none', visible > 0);
            if (noResultsTerm) noResultsTerm.textContent = `"${searchInput.value.trim()}"`;
            if (footerCount) footerCount.innerHTML = `Showing <strong>${visible}</strong> medication${visible === 1 ? '' : 's'}`;
        }

        searchInput.addEventListener('input', filter);
        searchClear.addEventListener('click', () => { searchInput.value = ''; filter(); searchInput.focus(); });
    </script>
}
