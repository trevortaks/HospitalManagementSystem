# Copy this file to .env before running docker compose:
# cp .env.example .env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hospitalms

JWT_SECRET=ChangeThisJwtSecretInProduction1234567890
CONNECTION_STRING=Host=postgres;Port=5432;Database=hospitalms;Username=postgres;Password=postgres
ASPNETCORE_ENVIRONMENT=Development

# Optional development tools
PGADMIN_DEFAULT_EMAIL=admin@hospitalms.local
PGADMIN_DEFAULT_PASSWORD=admin123!
